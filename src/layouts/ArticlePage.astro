---
import HeroArticle from "../components/HeroArticle.astro";
import HeroPaper from "../components/HeroPaper.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BackToTop from "../components/BackToTop.astro";
import Seo from "../components/Seo.astro";
import TableOfContents from "../components/TableOfContents.astro";
import HtmlEmbed from "../components/HtmlEmbed.astro";
import {
  SITE_AUTHOR,
  SITE_AUTHOR_URL,
  SITE_LICENSE,
  SITE_TITLE,
  SITE_URL,
} from "../consts";
import { normalizeTagList } from "../utils/tags";
import {
  ARTICLE_EDITORIAL,
  COMPLETION,
  CONTENT_TYPES,
  collectionHref,
} from "../data/article-editorial";
import type {
  HeroCollection,
  HeroProgress,
  HeroReadingTime,
} from "../components/heroUtils";
import {
  buildArticleCitation,
  flattenCitationTitle,
} from "../utils/citation";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface ReportMeta {
  org?: string;
  release?: string;
  baseOrArch?: string;
  quarter?: string;
  digest?: string;
  kind?: "note" | "brief";
  tags?: string[];
}

interface Props {
  articleMod: {
    default: any;
    frontmatter?: Record<string, unknown>;
  };
  lastModified?: string;
  readingTime?: HeroReadingTime;
  slug?: string;
  ogImage?: string;
  reportMeta?: ReportMeta;
}

const {
  articleMod: ArticleMod,
  lastModified,
  readingTime,
  slug,
  ogImage,
  reportMeta,
} = Astro.props as Props;

// Default OG image served from public/
const ogDefaultUrl = "/og-default.png";
const articleFM = (ArticleMod as any).frontmatter ?? {};
const Article = (ArticleMod as any).default;
const isDraft = articleFM?.draft === true || articleFM?.draft === "true";
const editorial = slug ? ARTICLE_EDITORIAL[slug] : undefined;
const completion = editorial?.completion;
const isNoindex = isDraft || completion === "outline" || reportMeta?.kind === "brief";
const statusBanner = isDraft
  ? {
      kind: "draft",
      badge: "Draft",
      text: "本文尚处于草稿阶段，内容未完成且暂未公开索引。",
    }
  : reportMeta?.kind === "brief"
    ? {
        kind: "outline",
        badge: "Brief Note",
        text: "这是一篇简短的技术报告速记，后续如有更完整资料会继续补充。",
      }
    : completion === "outline"
      ? {
          kind: "outline",
          badge: "Outline",
          text: "本文目前为大纲与早期笔记，核心章节仍在补充中。",
        }
      : completion === "growing"
        ? {
            kind: "growing",
            badge: "In Progress",
            text: "本文已包含主要内容，部分章节与推导仍在持续完善中。",
          }
        : null;
// Helper to strip HTML tags
const stripHtml = (text: string) => String(text || "").replace(/<[^>]*>/g, "");
// docTitle without HTML tags for SEO/meta
const docTitle = stripHtml(articleFM?.title ?? "Untitled article");
// Allow explicit line breaks in the title via "\n" or YAML newlines
const docTitleHtml = (articleFM?.title ?? "Untitled article")
  .replace(/\\n/g, "<br/>")
  .replace(/\n/g, "<br/>");
const subtitle = articleFM?.subtitle ?? "";
const description = articleFM?.description ?? "";
// Accept authors as string[] or array of objects { name, url, affiliations? }
const rawAuthors = (articleFM as any)?.authors ?? [];
type Affiliation = { id: number; name: string; url?: string };
type Author = { name: string; url?: string; affiliationIndices?: number[] };

// Normalize affiliations from frontmatter: supports strings or objects { id?, name, url? }
const rawAffils =
  (articleFM as any)?.affiliations ?? (articleFM as any)?.affiliation ?? [];
const normalizedAffiliations: Affiliation[] = (() => {
  const seen: Map<string, number> = new Map();
  const list: Affiliation[] = [];
  const pushUnique = (name: string, url?: string) => {
    const key = `${String(name).trim()}|${url ? String(url).trim() : ""}`;
    if (seen.has(key)) return seen.get(key)!;
    const id = list.length + 1;
    list.push({
      id,
      name: String(name).trim(),
      url: url ? String(url) : undefined,
    });
    seen.set(key, id);
    return id;
  };
  const input = Array.isArray(rawAffils)
    ? rawAffils
    : rawAffils
      ? [rawAffils]
      : [];
  for (const a of input) {
    if (typeof a === "string") {
      pushUnique(a);
    } else if (a && typeof a === "object") {
      const name = a.name ?? a.label ?? a.text ?? a.affiliation ?? "";
      if (!String(name).trim()) continue;
      const url = a.url || a.link;
      // Respect provided numeric id for display stability if present and sequential; otherwise reassign
      pushUnique(String(name), url ? String(url) : undefined);
    }
  }
  return list;
})();

// Helper: ensure an affiliation exists and return its id
const ensureAffiliation = (val: any): number | undefined => {
  if (val == null) return undefined;
  if (typeof val === "number" && Number.isFinite(val) && val > 0) {
    return Math.floor(val);
  }
  const name =
    typeof val === "string"
      ? val
      : (val?.name ?? val?.label ?? val?.text ?? val?.affiliation);
  if (!name || !String(name).trim()) return undefined;
  const existing = normalizedAffiliations.find(
    (a) => a.name === String(name).trim(),
  );
  if (existing) return existing.id;
  const id = normalizedAffiliations.length + 1;
  normalizedAffiliations.push({
    id,
    name: String(name).trim(),
    url: val?.url || val?.link,
  });
  return id;
};

// Normalize authors and map affiliations -> indices (Distill-like)
const normalizedAuthors: Author[] = (
  Array.isArray(rawAuthors) ? rawAuthors : []
)
  .map((a: any) => {
    if (typeof a === "string") {
      return { name: a } as Author;
    }
    const name = String(a?.name || "").trim();
    const url = a?.url || a?.link;
    let indices: number[] | undefined = undefined;
    const raw = a?.affiliations ?? a?.affiliation ?? a?.affils;
    if (raw != null) {
      const entries = Array.isArray(raw) ? raw : [raw];
      const ids = entries
        .map(ensureAffiliation)
        .filter((x): x is number => typeof x === "number");
      const unique = Array.from(new Set(ids)).sort((x, y) => x - y);
      if (unique.length) indices = unique;
    }
    return { name, url, affiliationIndices: indices } as Author;
  })
  .filter((a: Author) => a.name && a.name.trim().length > 0);
if (normalizedAuthors.length === 0) {
  normalizedAuthors.push({
    name: SITE_AUTHOR,
    url: SITE_AUTHOR_URL,
  });
}
const authorNames: string[] = normalizedAuthors.map((a) => a.name);
const published =
  typeof articleFM?.published === "string" ? articleFM.published : undefined;
const modified =
  lastModified ??
  ((articleFM as any)?.modified as string | undefined) ??
  (articleFM as any)?.updatedDate ??
  (articleFM as any)?.lastmod ??
  published;
const template: string = (articleFM as any)?.template ?? "article";
const rawTags = articleFM?.tags ?? reportMeta?.tags ?? [];
const tags: string[] = normalizeTagList(rawTags);
const categories = articleFM?.categories ?? undefined;
const resolvedContentType = editorial?.contentType ?? (reportMeta ? "reports" : undefined);
const heroCollection: HeroCollection | undefined = resolvedContentType
  ? {
      label: CONTENT_TYPES[resolvedContentType].shortLabel,
      href: collectionHref(resolvedContentType),
    }
  : undefined;
const heroProgress: HeroProgress | undefined = isDraft
  ? {
      kind: "draft",
      label: "Draft",
      description: "本文尚处于草稿阶段，内容未完成且暂未公开索引。",
    }
  : reportMeta?.kind === "brief"
    ? {
        kind: "brief",
        label: "Brief Note",
        description: "简短的技术报告速记，后续如有更完整资料会继续补充。",
      }
    : completion
      ? {
          kind: completion,
          label: COMPLETION[completion].label,
          description: COMPLETION[completion].description,
        }
      : reportMeta
        ? {
            kind: "complete",
            label: COMPLETION.complete.label,
            description: COMPLETION.complete.description,
          }
        : undefined;
// Prefer explicit ogImage / frontmatter seoThumbImage; otherwise use build-time generated /og/<slug>.png
const fmOg = articleFM?.seoThumbImage as string | undefined;
const resolvedOg = ogImage || fmOg || (slug ? `/og/${slug}.png` : ogDefaultUrl);
const imageAbs: string =
  resolvedOg.startsWith("http")
    ? resolvedOg
    : Astro.site
      ? new URL(resolvedOg, Astro.site).toString()
      : resolvedOg;

// ---- Build citation text & BibTeX from frontmatter ----
const rawTitle = articleFM?.title ?? "Untitled article";
const titleFlat = flattenCitationTitle(String(rawTitle));
const canonicalArticleUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? SITE_URL,
).toString();
const doi = (ArticleMod as any)?.frontmatter?.doi
  ? String((ArticleMod as any).frontmatter.doi)
  : undefined;
const { citationText, bibtex } = buildArticleCitation({
  title: titleFlat,
  authors: authorNames,
  published: (articleFM as any)?.published,
  url: canonicalArticleUrl,
  slug,
  doi,
});
const envCollapse = false;
const tableOfContentAutoCollapse = Boolean(
  (articleFM as any)?.tableOfContentAutoCollapse ??
    (articleFM as any)?.tableOfContentsAutoCollapse ??
    envCollapse,
);
// Licence note (HTML allowed)
const licence =
  (articleFM as any)?.licence ??
  (articleFM as any)?.license ??
  (articleFM as any)?.licenseNote ??
  SITE_LICENSE;

// External links (paper, code, data, demo, etc.) shown in paper template hero
const links: Array<{ label: string; url: string; icon?: string }> =
  ((articleFM as any)?.links ?? []).map((l: any) => ({
    label: l.label ?? l.name ?? l.text ?? "Link",
    url: l.url ?? l.href ?? l.link ?? "#",
    icon: l.icon,
  }));
const articleLang: string =
  typeof (articleFM as any)?.lang === "string" && (articleFM as any).lang.trim()
    ? String((articleFM as any).lang).trim()
    : "zh-CN";
const articleLocale = articleLang.toLowerCase().startsWith("zh")
  ? "zh_CN"
  : "en_US";
---

<html
  lang={articleLang}
  data-theme="light"
  data-template={template}
  data-toc-auto-collapse={tableOfContentAutoCollapse ? "1" : "0"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("/rss.xml", Astro.site ?? Astro.url)}
    />
    <Seo
      title={docTitle}
      description={description}
      authors={authorNames}
      published={published}
      modified={modified}
      tags={tags}
      image={imageAbs}
      noindex={isNoindex}
      locale={articleLocale}
      inLanguage={articleLang}
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          const prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = saved || (prefersDark ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch {}
      })();
    </script>
    <script is:inline>
      // Debounce all ResizeObserver callbacks to prevent layout thrashing
      // during window resize (10+ D3 embeds re-render simultaneously otherwise)
      (() => {
        const _RO = window.ResizeObserver;
        if (!_RO) return;
        const DEBOUNCE_MS = 100;
        window.ResizeObserver = class {
          constructor(cb) {
            this._timer = null;
            this._ro = new _RO((entries, observer) => {
              clearTimeout(this._timer);
              this._timer = setTimeout(() => {
                requestAnimationFrame(() => cb(entries, observer));
              }, DEBOUNCE_MS);
            });
          }
          observe(el, opts) { this._ro.observe(el, opts); }
          unobserve(el) { this._ro.unobserve(el); }
          disconnect() { this._ro.disconnect(); clearTimeout(this._timer); }
        };
      })();
    </script>
    <script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <script type="module" src="/scripts/color-palettes.js"></script>

    <script defer src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/medium-zoom@1.1.0/dist/medium-zoom.min.js"
    ></script>
    <script src="/src/scripts/mermaid-zoom.js"></script>
    <script>
      // Debug and global zoom initialization

      function initializeZoom() {
        const zoomableImages = document.querySelectorAll(
          'img[data-zoomable="true"]',
        );

        if ((window as any).mediumZoom && zoomableImages.length > 0) {
          zoomableImages.forEach((img, index) => {
            // Check if already initialized
            if (!img.classList.contains("medium-zoom-image")) {
              try {
                const instance = (window as any).mediumZoom(img, {
                  background: "rgba(0,0,0,.85)",
                  margin: 24,
                  scrollOffset: 0,
                });
              } catch (error) {
                console.error(
                  `Global script: Error initializing zoom for image ${index}:`,
                  error,
                );
              }
            } else {
              console.log(`Global script: Image ${index} already has zoom`);
            }
          });
        } else {
          console.log(
            "Global script: mediumZoom not available or no images found",
          );
        }
      }

      // Try to initialize immediately
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeZoom);
      } else {
        initializeZoom();
      }

      // Also try after complete loading
      window.addEventListener("load", () => {
        setTimeout(initializeZoom, 100);
      });
    </script>
    <script>
      // Refresh HF Space iframes on theme change
      (function () {
        try {
          let reloadTimer: number | null = null;
          const isTargetIframe = (el) => {
            if (!el || el.tagName !== "IFRAME") return false;
            const src = el.getAttribute("src") || "";
            return src.includes(".hf.space");
          };
          const reloadIframes = () => {
            const iframes = Array.from(
              document.querySelectorAll("iframe"),
            ).filter(isTargetIframe);
            const theme =
              document.documentElement.getAttribute("data-theme") || "light";
            iframes.forEach((iframe) => {
              try {
                const currentSrc = iframe.getAttribute("src");
                if (!currentSrc) return;
                const url = new URL(currentSrc, window.location.href);
                url.searchParams.set("_theme", theme);
                url.searchParams.set("_ts", Date.now().toString());
                iframe.setAttribute("src", url.toString());
              } catch {}
            });
          };
          const scheduleReload = () => {
            if (reloadTimer) clearTimeout(reloadTimer);
            reloadTimer = window.setTimeout(reloadIframes, 120);
          };
          const observer = new MutationObserver((mutations) => {
            for (const m of mutations) {
              if (m.type === "attributes" && m.attributeName === "data-theme") {
                scheduleReload();
                break;
              }
            }
          });
          observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme"],
          });
        } catch {}
      })();
    </script>
  </head>
  <body>
    <Header />

    {template === "paper" ? (
      <HeroPaper
        title={docTitleHtml}
        titleRaw={docTitle}
        description={subtitle || description}
        authors={normalizedAuthors as any}
        affiliations={normalizedAffiliations as any}
        affiliation={articleFM?.affiliation}
        published={published}
        modified={modified}
        links={links}
      />
    ) : (
      <HeroArticle
        title={docTitleHtml}
        titleRaw={docTitle}
        description={subtitle || description}
        authors={normalizedAuthors as any}
        affiliations={normalizedAffiliations as any}
        affiliation={articleFM?.affiliation}
        published={published}
        modified={modified}
        doi={doi}
        links={links}
        banner={articleFM?.banner}
        bannerAspectRatio={articleFM?.bannerAspectRatio}
        categories={categories as any}
        tags={tags}
        collection={heroCollection}
        readingTime={readingTime}
        progress={heroProgress}
      />
    )}

    {template === "paper" && articleFM?.banner && (
      <div class="paper-hero-banner" style={articleFM?.bannerAspectRatio ? `aspect-ratio: ${articleFM.bannerAspectRatio}` : undefined}>
        <HtmlEmbed src={articleFM?.banner || "banner.html"} frameless />
      </div>
    )}

    <section class="content-grid">
      <TableOfContents
        tableOfContentAutoCollapse={tableOfContentAutoCollapse}
      />
      <main>
        {reportMeta && (
          <nav class="report-context-card" aria-label="Technical report navigation">
            <div class="report-context-card__links">
              <a href="/blog/collections/reports/#single-report-index">← Single-Report Index</a>
              {reportMeta.digest && reportMeta.quarter && (
                <>
                  <span aria-hidden="true">·</span>
                  <a href={`/blog/${reportMeta.digest}/`}>
                    {reportMeta.quarter} 季度总结
                  </a>
                </>
              )}
            </div>
            {(reportMeta.org || reportMeta.release || reportMeta.baseOrArch) && (
              <div class="report-context-card__meta">
                {reportMeta.org && <span><strong>Org:</strong> {reportMeta.org}</span>}
                {reportMeta.release && <span><strong>Release:</strong> {reportMeta.release}</span>}
                {reportMeta.baseOrArch && <span><strong>Base / Arch:</strong> {reportMeta.baseOrArch}</span>}
              </div>
            )}
            {reportMeta.tags && reportMeta.tags.length > 0 && (
              <div class="report-context-card__tags">
                {reportMeta.tags.map((t) => (
                  <span class="report-context-card__tag">{t}</span>
                ))}
              </div>
            )}
          </nav>
        )}
        {statusBanner && (
          <aside class={`article-status-banner article-status-banner--${statusBanner.kind}`} role="note">
            <span class="article-status-banner__badge">{statusBanner.badge}</span>
            <span class="article-status-banner__text">{statusBanner.text}</span>
          </aside>
        )}
        <Article />
      </main>
    </section>

    <Footer
      citationText={citationText}
      bibtex={bibtex}
      licence={licence}
      doi={doi}
      template={template}
      articleTitle={titleFlat}
      articleUrl={canonicalArticleUrl}
      slug={slug}
    />

    <BackToTop />

    <script>
      // Open external links in a new tab; keep internal anchors in-page
      const setExternalTargets = () => {
        const isExternal = (href) => {
          try {
            const u = new URL(href, location.href);
            return u.origin !== location.origin;
          } catch {
            return false;
          }
        };
        document.querySelectorAll("a[href]").forEach((a) => {
          const href = a.getAttribute("href");
          if (!href) return;
          if (isExternal(href)) {
            a.setAttribute("target", "_blank");
            a.setAttribute("rel", "noopener noreferrer");
          } else {
            a.removeAttribute("target");
          }
        });
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setExternalTargets, {
          once: true,
        });
      } else {
        setExternalTargets();
      }
    </script>

    <script>
      // Delegate copy clicks for code blocks injected by rehypeCodeCopy
      document.addEventListener("click", async (e) => {
        const target = e.target instanceof Element ? e.target : null;
        const btn = target ? target.closest(".code-copy") : null;
        if (!btn) return;
        const card = btn.closest(".code-card");
        const pre = card && card.querySelector("pre");
        if (!pre) return;
        const text = pre.textContent || "";
        try {
          await navigator.clipboard.writeText(text.trim());
          const old = btn.innerHTML;
          btn.innerHTML =
            '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 16.2l-3.5-3.5-1.4 1.4L9 19 20.3 7.7l-1.4-1.4z"/></svg>';
          setTimeout(() => (btn.innerHTML = old), 1200);
        } catch {
          btn.textContent = "Error";
          setTimeout(() => (btn.textContent = "Copy"), 1200);
        }
      });
    </script>
  </body>
</html>

<style>
  .article-status-banner {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 14px;
    margin: 0 0 24px;
    border-radius: 6px;
    border: 1px solid var(--border-color, rgba(0, 0, 0, 0.12));
    background: var(--surface-bg, rgba(0, 0, 0, 0.03));
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .article-status-banner--draft {
    border-color: rgba(217, 119, 6, 0.4);
    background: rgba(217, 119, 6, 0.08);
  }
  .article-status-banner--outline {
    border-color: rgba(107, 114, 128, 0.35);
    background: rgba(107, 114, 128, 0.07);
  }
  .article-status-banner__badge {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.08);
  }
  :global([data-theme="dark"]) .article-status-banner__badge {
    background: rgba(255, 255, 255, 0.12);
  }
  .report-context-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 16px;
    margin: 0 0 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color, rgba(0, 0, 0, 0.12));
    background: var(--surface-bg, rgba(0, 0, 0, 0.03));
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .report-context-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }
  .report-context-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    color: var(--muted-color);
    font-size: 0.85rem;
  }
  .report-context-card__meta strong {
    color: var(--text-color);
    font-weight: 600;
  }
  .report-context-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .report-context-card__tag {
    display: inline-block;
    padding: 1px 9px;
    font-size: 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-color, rgba(0, 0, 0, 0.12));
    background: var(--page-bg, transparent);
    color: var(--muted-color);
  }
</style>
