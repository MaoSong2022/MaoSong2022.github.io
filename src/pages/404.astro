---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "404";
const description = "Page not found. Redirecting to a valid page.";

const articleEntryPaths = Object.keys(
  import.meta.glob("../content/*/article.{md,mdx}"),
);
const knownArticleSlugs = Array.from(
  new Set(
    articleEntryPaths
      .map((path) => path.match(/content\/([^/]+)\/article\.(?:md|mdx)$/)?.[1])
      .filter((slug): slug is string => Boolean(slug) && slug !== "demo"),
  ),
);

const legacySlugAliases: Record<string, string> = {
  opd: "on-policy-distillation",
  flashattention: "flash-attention",
  agenticrl: "agentic-rl",
  "llama-series": "llama",
  "qwen-series": "qwen",
  "deepseek-series": "deepseek",
  "qwen-vl-series": "qwen-vl",
  train_inference_mistahch: "train-inference-mismatch",
  tech_report: "tech-reports-2026-q4",
};
---

<BaseLayout pageTitle={pageTitle} description={description} noindex={true}>
  <script is:inline define:vars={{ knownArticleSlugs, legacySlugAliases }}>
    (() => {
      const knownSlugs = new Set(knownArticleSlugs);
      const knownSlugsByLower = new Map(
        knownArticleSlugs.map((slug) => [slug.toLowerCase(), slug]),
      );

      const resolveSlug = (raw) => {
        let decoded = raw;
        try {
          decoded = decodeURIComponent(raw);
        } catch {
          return null;
        }
        const lower = decoded.toLowerCase();
        const aliased = legacySlugAliases[lower];
        if (aliased && knownSlugs.has(aliased)) return aliased;
        return knownSlugsByLower.get(lower) ?? null;
      };

      const rawPath = window.location.pathname.replace(/\/{2,}/g, "/");
      const segments = rawPath.split("/").filter(Boolean);
      const suffix = `${window.location.search}${window.location.hash}`;

      let redirectTarget = "/";

      if ((segments[0] === "blog" || segments[0] === "p") && segments[1]) {
        const resolved = resolveSlug(segments[1]);
        if (resolved) {
          if (
            segments[0] === "blog" &&
            segments.length === 3 &&
            segments[2].toLowerCase() === "llms.txt"
          ) {
            redirectTarget = `/blog/${encodeURIComponent(resolved)}/llms.txt${suffix}`;
          } else if (segments.length === 2) {
            redirectTarget = `/blog/${encodeURIComponent(resolved)}/${suffix}`;
          }
        }
      }

      const currentUrl = `${window.location.pathname}${suffix}`;
      if (currentUrl !== redirectTarget) {
        window.location.replace(redirectTarget);
      }
    })();
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/" />
  </noscript>

  <p>
    This page does not exist. You are being redirected.
  </p>
  <p>
    Old paths like <code>/p/&lt;slug&gt;</code> or legacy uppercase
    <code>/blog/&lt;Slug&gt;</code> URLs are redirected to valid
    <code>/blog/&lt;slug&gt;</code> pages when available. Otherwise, we redirect
    to the homepage.
  </p>
  <p>
    If redirect does not happen automatically, <a href="/">go to homepage</a>.
  </p>
</BaseLayout>
