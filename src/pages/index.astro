---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  SITE_DESCRIPTION,
  SITE_SLOGAN,
  SITE_TITLE,
  GITHUB_USERNAME,
  GOOGLE_SCHOLAR_ID,
} from "../consts";
import avatarSrc from "../../public/avatar.jpg";
import { SITE_NEWS } from "../data/site-news";
import ArticleList from "../components/ArticleList.astro";
import ContentCollections from "../components/ContentCollections.astro";
import CompletionLegend from "../components/CompletionLegend.astro";
import { parseArticleGlob, selectFeatured } from "../utils/site-articles";
import { getAllArticleBundleLastModifiedIso } from "../utils/article-modified";

const articleGlob = import.meta.glob<{ frontmatter: Record<string, unknown> }>(
  "../content/*/article.{md,mdx}",
  { eager: true },
);

const modifiedBySlug = await getAllArticleBundleLastModifiedIso();
const articles = await parseArticleGlob(articleGlob, modifiedBySlug);
const tutorials = selectFeatured(articles, "learning");
const analyses = selectFeatured(articles, "analysis");

const newsItems = [...SITE_NEWS].sort((a, b) => {
  const ta = Date.parse(a.date);
  const tb = Date.parse(b.date);
  if (!Number.isNaN(ta) && !Number.isNaN(tb) && tb !== ta) return tb - ta;
  return String(b.date).localeCompare(String(a.date));
});

function newsDateLabel(raw: string): string {
  const t = Date.parse(raw);
  if (!Number.isNaN(t)) {
    return new Date(t).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }
  return raw;
}

function newsDateIso(raw: string): string | undefined {
  const t = Date.parse(raw);
  if (Number.isNaN(t)) return undefined;
  return new Date(t).toISOString().slice(0, 10);
}
---

<BaseLayout pageTitle={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="site-hero">
    <div class="site-hero__avatar">
      <Image
        src={avatarSrc}
        alt={`Profile photo — ${SITE_TITLE}`}
        width={192}
        height={192}
        loading="eager"
      />
    </div>
    <div class="site-hero__body">
      <p class="site-slogan">{SITE_SLOGAN}</p>
      <p class="site-lead">{SITE_DESCRIPTION}</p>
    </div>
  </div>

  <div class="site-actions">
    <a class="button button--ghost" href="/blog">Browse all posts</a>
    <a class="button button--ghost" href="/about">About</a>
    <a class="button button--ghost" href={`https://github.com/${GITHUB_USERNAME}`}>Github</a>
    <a class="button button--ghost" href={`https://scholar.google.com/citations?user=${GOOGLE_SCHOLAR_ID}`}>Google Scholar</a>
  </div>

  <section aria-labelledby="tutorials-heading">
    <p class="section-eyebrow">START HERE</p>
    <h2 id="tutorials-heading">Featured Tutorials</h2>
    <p class="section-intro">Foundational guides for building a reusable mental model.</p>
    <ArticleList articles={tutorials} compact />
  </section>

  <section aria-labelledby="analysis-heading">
    <h2 id="analysis-heading">Deep Dives</h2>
    <p class="section-intro">Question-driven derivations and comparisons. These articles are in progress; their status reflects the current reading experience.</p>
    <ArticleList articles={analyses} compact />
    <p class="section-more"><a href="/blog/collections/analysis/">All Deep Dives →</a></p>
  </section>

  <section aria-labelledby="collections-heading">
    <h2 id="collections-heading">Explore by Content Type</h2>
    <ContentCollections articles={articles} />
    <CompletionLegend />
  </section>

  {
    newsItems.length > 0 ? (
      <section class="site-news" aria-labelledby="news-heading">
        <h2 id="news-heading">News</h2>
        <ul class="site-news__list">
          {newsItems.map((item) => {
            const isExternal =
              item.href &&
              (item.href.startsWith("http://") ||
                item.href.startsWith("https://"));
            const dateIso = newsDateIso(item.date);
            return (
              <li class="site-news__item">
                <time
                  class="site-news__date"
                  {...(dateIso ? { datetime: dateIso } : {})}
                >
                  {newsDateLabel(item.date)}
                </time>
                <div class="site-news__body">
                  {item.href ? (
                    <a
                      class="site-news__title-link"
                      href={item.href}
                      {...(isExternal
                        ? {
                            target: "_blank",
                            rel: "noopener noreferrer",
                          }
                        : {})}
                    >
                      {item.title}
                    </a>
                  ) : (
                    <span class="site-news__title">{item.title}</span>
                  )}
                  {item.summary ? (
                    <p class="site-news__summary">{item.summary}</p>
                  ) : null}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ) : null
  }

</BaseLayout>
