---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import avatarSrc from "../../public/avatar.jpg";
import {
  SITE_AUTHOR,
  SITE_TITLE,
  SITE_URL,
  GITHUB_USERNAME,
  GOOGLE_SCHOLAR_ID,
  CONTACT_EMAIL,
  BILIBILI_URL,
  ZHIHU_URL,
  CV_URL,
} from "../consts";
import { SITE_PUBLICATIONS } from "../data/site-publications";

const pageTitle = "About";
const description =
  "Mao Song (毛松 / 以往的月), researcher at SenseTime — LLM post-training, reinforcement learning, MLLMs, and training systems.";

const scholarUrl = `https://scholar.google.com/citations?user=${GOOGLE_SCHOLAR_ID}`;
const githubUrl = `https://github.com/${GITHUB_USERNAME}`;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE_AUTHOR,
  alternateName: ["毛松", "以往的月"],
  url: new URL("/about", Astro.site ?? SITE_URL).toString(),
  image: new URL("/avatar.jpg", Astro.site ?? SITE_URL).toString(),
  email: `mailto:${CONTACT_EMAIL}`,
  jobTitle: "Researcher",
  worksFor: {
    "@type": "Organization",
    name: "SenseTime",
    url: "https://www.sensetime.com/",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "ShanghaiTech University",
      url: "https://www.shanghaitech.edu.cn/",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Beijing Institute of Technology",
      url: "https://www.bit.edu.cn/",
    },
  ],
  knowsAbout: [
    "Large Language Models",
    "LLM Post-Training",
    "Reinforcement Learning",
    "Multimodal Large Language Models",
    "Distributed Training Systems",
  ],
  sameAs: [scholarUrl, githubUrl, BILIBILI_URL, ...(ZHIHU_URL ? [ZHIHU_URL] : [])],
};

type ResearchArea = {
  title: string;
  description: string;
  tags: string[];
};

const researchAreas: ResearchArea[] = [
  {
    title: "LLM Post-Training & RL",
    description:
      "Post-training pipelines and reinforcement learning methods that align and scale language model capabilities.",
    tags: ["RLHF", "RLVR", "Agentic RL", "Policy Optimization"],
  },
  {
    title: "Reasoning Models",
    description:
      "Building models capable of verifiable multi-step reasoning, long-horizon planning, and self-correction.",
    tags: ["Test-Time Scaling", "Math & Code", "Long CoT"],
  },
  {
    title: "Multimodal LLMs",
    description:
      "Bridging visual perception, language reasoning, and unified understanding & generation across modalities.",
    tags: ["MLLM", "Vision Encoders", "Unified Models"],
  },
  {
    title: "Training Systems & Efficiency",
    description:
      "Understanding and optimizing large-scale distributed training, inference alignment, and compute efficiency.",
    tags: ["Parallelism", "FSDP", "Train-Inference Mismatch"],
  },
];

type TimelineItem = {
  period: string;
  role: string;
  org: string;
  orgUrl?: string;
  team?: { label: string; href: string };
  advisor?: { label: string; href: string };
  detail?: string;
};

const experienceItems: TimelineItem[] = [
  {
    period: "2026.09 – Present",
    role: "Researcher",
    org: "SenseTime (商汤科技)",
    orgUrl: "https://www.sensetime.com/",
    detail: "Focusing on LLM post-training and multimodal foundation models.",
  },
  {
    period: "2022.08 – 2026.08",
    role: "Researcher",
    org: "Shanghai Artificial Intelligence Laboratory (上海人工智能实验室)",
    orgUrl: "https://www.shlab.org.cn/",
    team: {
      label: "KnowledgeXLab",
      href: "https://knowledgexlab.github.io/",
    },
    detail: "Worked on MLLMs, LLM post-training, and their applications.",
  },
];

const educationItems: TimelineItem[] = [
  {
    period: "2019.09 – 2022.07",
    role: "M.S. in Computer Science",
    org: "ShanghaiTech University",
    orgUrl: "https://www.shanghaitech.edu.cn/",
    advisor: {
      label: "Prof. Hao Wang",
      href: "https://sist.shanghaitech.edu.cn/wanghao1/main.htm",
    },
    detail: "Focused on convex & non-convex optimization and its applications.",
  },
  {
    period: "2015.09 – 2019.07",
    role: "B.S. in Information and Computing Science",
    org: "Beijing Institute of Technology",
    orgUrl: "https://www.bit.edu.cn/",
  },
];
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <div class="about-page">
    <section class="about-profile" aria-label="Profile overview">
      <div class="about-profile__avatar">
        <Image
          src={avatarSrc}
          alt={`Profile photo — ${SITE_TITLE}`}
          width={192}
          height={192}
          loading="eager"
        />
      </div>
      <div class="about-profile__body">
        <p class="about-profile__name">
          Mao Song (毛松)
          <span class="about-profile__alias">· 以往的月</span>
        </p>
        <p class="about-profile__role">
          Researcher at SenseTime · LLM Post-Training, RL &amp; MLLMs
        </p>
        <div class="about-profile__actions">
          <a class="button button--ghost" href={`mailto:${CONTACT_EMAIL}`}>Email</a>
          <a
            class="button button--ghost"
            href={scholarUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Scholar
          </a>
          <a
            class="button button--ghost"
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          {CV_URL && (
            <a
              class="button button--ghost"
              href={CV_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              CV
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="about-section" aria-labelledby="intro-heading">
      <h2 id="intro-heading">Introduction</h2>
      <div class="intro-section">
        <p>
          I am <strong>Mao Song (毛松)</strong>, a researcher at{" "}
          <a
            href="https://www.sensetime.com/"
            target="_blank"
            rel="noopener noreferrer"
          >SenseTime (商汤科技)</a>, where I work on{" "}
          <strong>Large Language Model (LLM) post-training</strong>,{" "}
          <strong>reinforcement learning</strong>, and{" "}
          <strong>Multimodal Large Language Models (MLLMs)</strong>.
        </p>
        <p>
          Previously, I worked as a researcher at{" "}
          <a
            href="https://www.shlab.org.cn/"
            target="_blank"
            rel="noopener noreferrer"
          >Shanghai Artificial Intelligence Laboratory (Shanghai AI Lab)</a>.
          Outside of papers and code, I write and share technical notes under
          the handle <strong>“以往的月”</strong> on Zhihu, Bilibili, and WeChat
          Official Account.
        </p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="research-heading">
      <h2 id="research-heading">Research Interests</h2>
      <div class="about-research-grid">
        {researchAreas.map((area) => (
          <article class="about-research-card">
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <div class="about-research-card__tags">
              {area.tags.map((tag) => (
                <span class="article-index__tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience &amp; Education</h2>

      <h3 class="about-subheading">Experience</h3>
      <ul class="about-timeline">
        {experienceItems.map((item) => (
          <li class="about-timeline__item">
            <span class="about-timeline__period">{item.period}</span>
            <div class="about-timeline__body">
              <div class="about-timeline__headline">
                <strong>{item.role}</strong>
                {" · "}
                {item.orgUrl ? (
                  <a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
                    {item.org}
                  </a>
                ) : (
                  <span>{item.org}</span>
                )}
              </div>
              {(item.team || item.detail) && (
                <p class="about-timeline__detail">
                  {item.team && (
                    <>
                      <a
                        href={item.team.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.team.label}
                      </a>
                      {item.detail ? " — " : ""}
                    </>
                  )}
                  {item.detail}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>

      <h3 class="about-subheading">Education</h3>
      <ul class="about-timeline">
        {educationItems.map((item) => (
          <li class="about-timeline__item">
            <span class="about-timeline__period">{item.period}</span>
            <div class="about-timeline__body">
              <div class="about-timeline__headline">
                <strong>{item.role}</strong>
                {" · "}
                {item.orgUrl ? (
                  <a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
                    {item.org}
                  </a>
                ) : (
                  <span>{item.org}</span>
                )}
              </div>
              {(item.advisor || item.detail) && (
                <p class="about-timeline__detail">
                  {item.advisor && (
                    <>
                      Supervised by{" "}
                      <a
                        href={item.advisor.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.advisor.label}
                      </a>
                      {item.detail ? ". " : ""}
                    </>
                  )}
                  {item.detail}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section" aria-labelledby="highlights-heading">
      <h2 id="highlights-heading">Selected Work</h2>
      <ul class="site-pubs__list">
        {SITE_PUBLICATIONS.map((pub) => (
          <li class="site-pubs__item">
            <span class="site-pubs__venue">{pub.venue}</span>
            <div class="site-pubs__body">
              <span class="site-pubs__title">{pub.title}</span>
              <p class="site-pubs__summary">{pub.summary}</p>
              {pub.links.length > 0 && (
                <div class="site-pubs__links">
                  {pub.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label} →
                    </a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
        <li class="site-pubs__item">
          <span class="site-pubs__venue">Open Source</span>
          <div class="site-pubs__body">
            <span class="site-pubs__title">astro-blog-template</span>
            <p class="site-pubs__summary">
              The open-source Astro template powering this site, designed for
              research articles, math-heavy tutorials, and technical blogs.
            </p>
            <div class="site-pubs__links">
              <a
                href="https://github.com/MaoSong2022/astro-blog-template"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub →
              </a>
            </div>
          </div>
        </li>
      </ul>
      <p class="section-more">
        <a href={scholarUrl} target="_blank" rel="noopener noreferrer">
          Full publication list on Google Scholar →
        </a>
      </p>
    </section>

    <section class="about-section" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Get in Touch</h2>
      <div class="contact-section">
        <p>
          I&apos;m always glad to discuss research collaborations, technical
          ideas, or potential opportunities. Feel free to reach out!
        </p>
        <p class="about-email-row">
          <strong>Email:</strong>{" "}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          <button
            type="button"
            class="about-copy-btn"
            data-copy-email={CONTACT_EMAIL}
            aria-label={`Copy ${CONTACT_EMAIL} to clipboard`}
          >
            Copy
          </button>
        </p>
        <p>
          <strong>Resume / CV:</strong>{" "}
          {CV_URL ? (
            <a href={CV_URL} target="_blank" rel="noopener noreferrer">
              Download PDF
            </a>
          ) : (
            <>
              Available upon request via{" "}
              <a href={`mailto:${CONTACT_EMAIL}`}>email</a>.
            </>
          )}
        </p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="social-heading">
      <h2 id="social-heading">Find Me Online</h2>
      <div class="social-links-section">
        <div class="social-grid">
          <a
            href={scholarUrl}
            class="social-card scholar-card"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="social-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"
                ></path>
              </svg>
            </div>
            <div class="social-info">
              <h3>Google Scholar</h3>
              <p>Publications &amp; citations</p>
            </div>
          </a>

          <a
            href={githubUrl}
            class="social-card github-card"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="social-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
            </div>
            <div class="social-info">
              <h3>GitHub</h3>
              <p>Open source projects &amp; code</p>
            </div>
          </a>

          <a
            href={BILIBILI_URL}
            class="social-card bilibili-card"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="social-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z"
                ></path>
              </svg>
            </div>
            <div class="social-info">
              <h3>Bilibili</h3>
              <p>Learning videos &amp; tutorials</p>
            </div>
          </a>

          <div class="social-card wechat-card" data-wechat-card>
            <button
              type="button"
              class="wechat-card__trigger"
              aria-expanded="false"
              aria-controls="wechat-qr-popup"
              data-wechat-toggle
            >
              <div class="social-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1 .166-.555c1.548-1.18 2.485-2.87 2.485-4.716 0-3.503-3.161-6.026-6.799-6.026h-.234zm-.24 1.66c.567 0 1.027.467 1.027 1.042 0 .573-.46 1.04-1.027 1.04-.566 0-1.027-.467-1.027-1.04 0-.575.461-1.041 1.027-1.041zm4.81 0c.567 0 1.027.467 1.027 1.042 0 .573-.46 1.04-1.027 1.04-.565 0-1.027-.467-1.027-1.04 0-.575.462-1.041 1.027-1.041z"
                  ></path>
                </svg>
              </div>
              <div class="social-info">
                <h3>WeChat Official Account</h3>
                <p>Click to show QR code</p>
              </div>
              <span class="wechat-card__chevron" aria-hidden="true">▾</span>
            </button>
            <div id="wechat-qr-popup" class="wechat-qr-popup" hidden>
              <img
                src="/wechat_avatar.jpg"
                alt="WeChat Official Account QR code for 以往的月"
                width="200"
                height="200"
                loading="lazy"
                decoding="async"
              />
              <p>Scan with WeChat to follow「以往的月」</p>
            </div>
          </div>

          {ZHIHU_URL && (
            <a
              href={ZHIHU_URL}
              class="social-card zhihu-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="social-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M5.721 0C2.251 0 0 2.25 0 5.719V18.28C0 21.751 2.252 24 5.721 24h12.56C21.751 24 24 21.75 24 18.281V5.72C24 2.249 21.75 0 18.281 0zm1.964 4.078c-.274.73-.577 1.464-.907 2.185h4.342c.46 0 .828.368.828.828v.693H9.546c-.048 1.24-.148 2.416-.301 3.516h2.893c.46 0 .828.368.828.828v.693H9.035c-.207.98-.5 1.883-.873 2.707l3.012 2.478c.192.159.222.443.066.638l-.522.648a.453.453 0 0 1-.636.068l-2.587-2.129c-.741 1.106-1.716 2.028-2.927 2.742a.454.454 0 0 1-.619-.158l-.394-.672a.452.452 0 0 1 .16-.618c1.727-1.015 2.86-2.587 3.397-4.696H4.017a.454.454 0 0 1-.454-.454v-.613c0-.25.203-.454.454-.454h3.332c.134-1.045.219-2.192.254-3.44H5.97c-.398.716-.834 1.38-1.307 1.982a.453.453 0 0 1-.637.075l-.553-.44a.453.453 0 0 1-.075-.637c1.095-1.39 1.966-3.175 2.607-5.342a.454.454 0 0 1 .435-.324h.816c.308 0 .527.302.429.595zm6.115 2.02h5.92c.46 0 .832.372.832.831v11.174a.832.832 0 0 1-.832.831h-5.92a.832.832 0 0 1-.832-.831V6.929c0-.46.373-.832.832-.832zm.71 1.54v9.756h4.5V7.638z"
                  ></path>
                </svg>
              </div>
              <div class="social-info">
                <h3>Zhihu (知乎)</h3>
                <p>Articles &amp; technical answers</p>
              </div>
            </a>
          )}
        </div>
      </div>
    </section>

    <p class="about-back">
      <a href="/blog">← Back to the blog</a>
    </p>
  </div>

  <script is:inline>
    (() => {
      // Copy email button
      document.querySelectorAll("[data-copy-email]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const email = btn.getAttribute("data-copy-email");
          if (!email) return;
          const original = btn.textContent || "Copy";
          try {
            await navigator.clipboard.writeText(email);
            btn.textContent = "Copied!";
            btn.setAttribute("data-copied", "true");
          } catch {
            btn.textContent = "Copy failed";
          }
          setTimeout(() => {
            btn.textContent = original;
            btn.removeAttribute("data-copied");
          }, 1600);
        });
      });

      // Click-to-toggle WeChat QR card (desktop popover + mobile inline drawer)
      const wechatCard = document.querySelector("[data-wechat-card]");
      const toggleBtn = wechatCard?.querySelector("[data-wechat-toggle]");
      const qrPopup = wechatCard?.querySelector("#wechat-qr-popup");
      if (wechatCard && toggleBtn && qrPopup) {
        const setOpen = (open) => {
          toggleBtn.setAttribute("aria-expanded", String(open));
          wechatCard.classList.toggle("is-open", open);
          qrPopup.hidden = !open;
        };

        toggleBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = toggleBtn.getAttribute("aria-expanded") === "true";
          setOpen(!isOpen);
        });

        document.addEventListener("click", (e) => {
          if (
            toggleBtn.getAttribute("aria-expanded") === "true" &&
            !wechatCard.contains(e.target)
          ) {
            setOpen(false);
          }
        });

        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            toggleBtn.getAttribute("aria-expanded") === "true"
          ) {
            setOpen(false);
            toggleBtn.focus();
          }
        });
      }
    })();
  </script>
</BaseLayout>
