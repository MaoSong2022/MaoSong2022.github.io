---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import avatarSrc from "../../public/avatar.jpg";
import {
  SITE_AUTHOR,
  SITE_TITLE,
  SITE_URL,
  GITHUB_USERNAME,
  GOOGLE_SCHOLAR_ID,
  CONTACT_EMAIL,
  BILIBILI_URL,
  ZHIHU_URL,
  CV_URL,
} from "../consts";
import { SITE_PUBLICATIONS } from "../data/site-publications";

const pageTitle = "About";
const description =
  "毛松（Mao Song / 以往的月），商汤科技研究员，聚焦大语言模型后训练（LLM Post-Training）、强化学习（RL）、多模态大模型（MLLM）与分布式训练系统。";

const scholarUrl = `https://scholar.google.com/citations?user=${GOOGLE_SCHOLAR_ID}`;
const githubUrl = `https://github.com/${GITHUB_USERNAME}`;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE_AUTHOR,
  alternateName: ["毛松", "以往的月"],
  url: new URL("/about", Astro.site ?? SITE_URL).toString(),
  image: new URL("/avatar.jpg", Astro.site ?? SITE_URL).toString(),
  email: `mailto:${CONTACT_EMAIL}`,
  jobTitle: "Researcher",
  worksFor: {
    "@type": "Organization",
    name: "SenseTime",
    url: "https://www.sensetime.com/",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "ShanghaiTech University",
      url: "https://www.shanghaitech.edu.cn/",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Beijing Institute of Technology",
      url: "https://www.bit.edu.cn/",
    },
  ],
  knowsAbout: [
    "Large Language Models",
    "LLM Post-Training",
    "Reinforcement Learning",
    "Transformer Architecture",
    "Multimodal Large Language Models",
    "Distributed Training Systems",
  ],
  sameAs: [scholarUrl, githubUrl, BILIBILI_URL, ...(ZHIHU_URL ? [ZHIHU_URL] : [])],
};

type ResearchArea = {
  titleZh: string;
  titleEn: string;
  descZh: string;
  descEn: string;
  tags: string[];
};

const researchAreas: ResearchArea[] = [
  {
    titleZh: "LLM 后训练与强化学习",
    titleEn: "LLM Post-Training & RL",
    descZh: "探索大语言模型后训练范式与强化学习算法，持续提升模型的对齐效果与能力上限。",
    descEn:
      "Post-training pipelines and reinforcement learning methods that align and scale language model capabilities.",
    tags: ["RLHF", "RLVR", "Agentic RL", "Policy Optimization"],
  },
  {
    titleZh: "模型架构与前沿技术报告",
    titleEn: "Model Architecture & Tech Reports",
    descZh: "持续追踪各家 Frontier Lab 的技术报告，系统梳理 Attention、FFN、MoE 与长上下文等核心架构演进。",
    descEn:
      "Following technical reports from frontier labs and writing systematic topic overviews on Attention, FFN, MoE, and long-context architectures.",
    tags: ["Attention", "FFN / MoE", "Long Context", "Tech Reports"],
  },
  {
    titleZh: "多模态大模型（MLLM）",
    titleEn: "Multimodal LLMs",
    descZh: "探索视觉感知与语言推理的融合，以及统一理解与生成的多模态基础模型架构。",
    descEn:
      "Bridging visual perception, language reasoning, and unified understanding & generation across modalities.",
    tags: ["MLLM", "Vision Encoders", "Unified Models"],
  },
  {
    titleZh: "训练系统与效率优化",
    titleEn: "Training Systems & Efficiency",
    descZh: "关注大规模分布式训练、训练-推理一致性分析与算力效率优化，弥合算法与系统之间的鸿沟。",
    descEn:
      "Understanding and optimizing large-scale distributed training, inference alignment, and compute efficiency.",
    tags: ["Parallelism", "FSDP", "Train-Inference Mismatch"],
  },
];

type TimelineItem = {
  periodZh: string;
  periodEn: string;
  roleZh: string;
  roleEn: string;
  orgZh: string;
  orgEn: string;
  orgUrl?: string;
  team?: { label: string; href: string };
  advisor?: { labelZh: string; labelEn: string; href: string };
  detailZh?: string;
  detailEn?: string;
};

const experienceItems: TimelineItem[] = [
  {
    periodZh: "2026.09 – 至今",
    periodEn: "2026.09 – Present",
    roleZh: "研究员",
    roleEn: "Researcher",
    orgZh: "商汤科技（SenseTime）",
    orgEn: "SenseTime",
    orgUrl: "https://www.sensetime.com/",
    detailZh: "聚焦大语言模型后训练（LLM Post-Training）与多模态基础模型研究。",
    detailEn: "Focusing on LLM post-training and multimodal foundation models.",
  },
  {
    periodZh: "2022.08 – 2026.08",
    periodEn: "2022.08 – 2026.08",
    roleZh: "研究员",
    roleEn: "Researcher",
    orgZh: "上海人工智能实验室（Shanghai AI Lab）",
    orgEn: "Shanghai Artificial Intelligence Laboratory",
    orgUrl: "https://www.shlab.org.cn/",
    team: {
      label: "KnowledgeXLab",
      href: "https://knowledgexlab.github.io/",
    },
    detailZh: "从事多模态大模型（MLLM）、LLM 后训练及其应用研究。",
    detailEn: "Worked on MLLMs, LLM post-training, and their applications.",
  },
];

const educationItems: TimelineItem[] = [
  {
    periodZh: "2019.09 – 2022.07",
    periodEn: "2019.09 – 2022.07",
    roleZh: "计算机科学硕士",
    roleEn: "M.S. in Computer Science",
    orgZh: "上海科技大学",
    orgEn: "ShanghaiTech University",
    orgUrl: "https://www.shanghaitech.edu.cn/",
    advisor: {
      labelZh: "王浩教授（Prof. Hao Wang）",
      labelEn: "Prof. Hao Wang",
      href: "https://sist.shanghaitech.edu.cn/wanghao1/main.htm",
    },
    detailZh: "研究方向为凸/非凸优化算法及其应用。",
    detailEn: "Focused on convex & non-convex optimization and its applications.",
  },
  {
    periodZh: "2015.09 – 2019.07",
    periodEn: "2015.09 – 2019.07",
    roleZh: "信息与计算科学学士",
    roleEn: "B.S. in Information and Computing Science",
    orgZh: "北京理工大学",
    orgEn: "Beijing Institute of Technology",
    orgUrl: "https://www.bit.edu.cn/",
  },
];
---

<BaseLayout pageTitle={pageTitle} description={description} lang="zh-CN">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <div class="about-page" data-about-lang="zh">
    <div class="about-lang-bar">
      <div class="about-lang-switch" role="group" aria-label="Language switch">
        <button
          type="button"
          class="about-lang-btn"
          data-set-lang="zh"
          aria-pressed="true"
        >
          中文
        </button>
        <button
          type="button"
          class="about-lang-btn"
          data-set-lang="en"
          aria-pressed="false"
        >
          English
        </button>
      </div>
    </div>

    <section class="about-profile" aria-label="Profile overview">
      <div class="about-profile__avatar">
        <Image
          src={avatarSrc}
          alt={`Profile photo — ${SITE_TITLE}`}
          width={192}
          height={192}
          loading="eager"
        />
      </div>
      <div class="about-profile__body">
        <p class="about-profile__name">
          <span data-lang="zh">毛松 (Mao Song)</span>
          <span data-lang="en">Mao Song (毛松)</span>
          <span class="about-profile__alias">· 以往的月</span>
        </p>
        <p class="about-profile__role">
          <span data-lang="zh">商汤科技研究员 · LLM 后训练、强化学习与多模态大模型</span>
          <span data-lang="en">Researcher at SenseTime · LLM Post-Training, RL &amp; MLLMs</span>
        </p>
        <div class="about-profile__actions">
          <a class="button button--ghost" href={`mailto:${CONTACT_EMAIL}`}>
            <span data-lang="zh">邮箱联系</span>
            <span data-lang="en">Email</span>
          </a>
          <a
            class="button button--ghost"
            href={scholarUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Scholar
          </a>
          <a
            class="button button--ghost"
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          {CV_URL && (
            <a
              class="button button--ghost"
              href={CV_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              CV
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="about-section" aria-labelledby="intro-heading">
      <h2 id="intro-heading">
        <span data-lang="zh">个人简介</span>
        <span data-lang="en">Introduction</span>
      </h2>
      <div class="intro-section" data-lang="zh">
        <p>
          你好，我是<strong>毛松（Mao Song）</strong>，目前就职于{" "}
          <a
            href="https://www.sensetime.com/"
            target="_blank"
            rel="noopener noreferrer"
          >商汤科技（SenseTime）</a>担任研究员，研究重心围绕
          <strong>大语言模型后训练（LLM Post-Training）</strong>、
          <strong>强化学习（RL）</strong>与
          <strong>多模态大模型（MLLM）</strong>。
        </p>
        <p>
          此前，我曾在{" "}
          <a
            href="https://www.shlab.org.cn/"
            target="_blank"
            rel="noopener noreferrer"
          >上海人工智能实验室（Shanghai AI Lab）</a>{" "}
          <a
            href="https://knowledgexlab.github.io/"
            target="_blank"
            rel="noopener noreferrer"
          >KnowledgeXLab</a> 担任研究员。工作之余，我也以<strong>「以往的月」</strong>为名在知乎、B 站和微信公众号持续分享技术笔记与推导教程。
        </p>
      </div>
      <div class="intro-section" data-lang="en">
        <p>
          I am <strong>Mao Song (毛松)</strong>, a researcher at{" "}
          <a
            href="https://www.sensetime.com/"
            target="_blank"
            rel="noopener noreferrer"
          >SenseTime</a>, where I work on{" "}
          <strong>Large Language Model (LLM) post-training</strong>,{" "}
          <strong>reinforcement learning</strong>, and{" "}
          <strong>Multimodal Large Language Models (MLLMs)</strong>.
        </p>
        <p>
          Previously, I was a researcher in{" "}
          <a
            href="https://knowledgexlab.github.io/"
            target="_blank"
            rel="noopener noreferrer"
          >KnowledgeXLab</a>{" "}
          at{" "}
          <a
            href="https://www.shlab.org.cn/"
            target="_blank"
            rel="noopener noreferrer"
          >Shanghai Artificial Intelligence Laboratory (Shanghai AI Lab)</a>.
          Outside of papers and code, I write and share technical notes under
          the handle <strong>“以往的月”</strong> on Zhihu, Bilibili, and WeChat
          Official Account.
        </p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="research-heading">
      <h2 id="research-heading">
        <span data-lang="zh">研究方向</span>
        <span data-lang="en">Research Interests</span>
      </h2>
      <div class="about-research-grid">
        {researchAreas.map((area) => (
          <article class="about-research-card">
            <h3>
              <span data-lang="zh">{area.titleZh}</span>
              <span data-lang="en">{area.titleEn}</span>
            </h3>
            <p>
              <span data-lang="zh">{area.descZh}</span>
              <span data-lang="en">{area.descEn}</span>
            </p>
            <div class="about-research-card__tags">
              {area.tags.map((tag) => (
                <span class="article-index__tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">
        <span data-lang="zh">经历与教育背景</span>
        <span data-lang="en">Experience &amp; Education</span>
      </h2>

      <h3 class="about-subheading">
        <span data-lang="zh">工作经历</span>
        <span data-lang="en">Experience</span>
      </h3>
      <ul class="about-timeline">
        {experienceItems.map((item) => (
          <li class="about-timeline__item">
            <span class="about-timeline__period">
              <span data-lang="zh">{item.periodZh}</span>
              <span data-lang="en">{item.periodEn}</span>
            </span>
            <div class="about-timeline__body">
              <div class="about-timeline__headline">
                <strong>
                  <span data-lang="zh">{item.roleZh}</span>
                  <span data-lang="en">{item.roleEn}</span>
                </strong>
                {" · "}
                {item.orgUrl ? (
                  <a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
                    <span data-lang="zh">{item.orgZh}</span>
                    <span data-lang="en">{item.orgEn}</span>
                  </a>
                ) : (
                  <>
                    <span data-lang="zh">{item.orgZh}</span>
                    <span data-lang="en">{item.orgEn}</span>
                  </>
                )}
              </div>
              {(item.team || item.detailZh || item.detailEn) && (
                <p class="about-timeline__detail">
                  {item.team && (
                    <>
                      <a
                        href={item.team.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.team.label}
                      </a>
                      {" — "}
                    </>
                  )}
                  <span data-lang="zh">{item.detailZh}</span>
                  <span data-lang="en">{item.detailEn}</span>
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>

      <h3 class="about-subheading">
        <span data-lang="zh">教育背景</span>
        <span data-lang="en">Education</span>
      </h3>
      <ul class="about-timeline">
        {educationItems.map((item) => (
          <li class="about-timeline__item">
            <span class="about-timeline__period">
              <span data-lang="zh">{item.periodZh}</span>
              <span data-lang="en">{item.periodEn}</span>
            </span>
            <div class="about-timeline__body">
              <div class="about-timeline__headline">
                <strong>
                  <span data-lang="zh">{item.roleZh}</span>
                  <span data-lang="en">{item.roleEn}</span>
                </strong>
                {" · "}
                {item.orgUrl ? (
                  <a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
                    <span data-lang="zh">{item.orgZh}</span>
                    <span data-lang="en">{item.orgEn}</span>
                  </a>
                ) : (
                  <>
                    <span data-lang="zh">{item.orgZh}</span>
                    <span data-lang="en">{item.orgEn}</span>
                  </>
                )}
              </div>
              {(item.advisor || item.detailZh || item.detailEn) && (
                <p class="about-timeline__detail">
                  {item.advisor && (
                    <>
                      <span data-lang="zh">
                        导师：
                        <a
                          href={item.advisor.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {item.advisor.labelZh}
                        </a>
                        {item.detailZh ? "；" : ""}
                      </span>
                      <span data-lang="en">
                        Supervised by{" "}
                        <a
                          href={item.advisor.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {item.advisor.labelEn}
                        </a>
                        {item.detailEn ? ". " : ""}
                      </span>
                    </>
                  )}
                  {item.detailZh && <span data-lang="zh">{item.detailZh}</span>}
                  {item.detailEn && <span data-lang="en">{item.detailEn}</span>}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section" aria-labelledby="highlights-heading">
      <h2 id="highlights-heading">
        <span data-lang="zh">代表工作</span>
        <span data-lang="en">Selected Work</span>
      </h2>
      <ul class="site-pubs__list">
        {SITE_PUBLICATIONS.map((pub) => (
          <li class="site-pubs__item">
            <span class="site-pubs__venue">{pub.venue}</span>
            <div class="site-pubs__body">
              <span class="site-pubs__title">{pub.title}</span>
              <p class="site-pubs__summary">{pub.summary}</p>
              {pub.links.length > 0 && (
                <div class="site-pubs__links">
                  {pub.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label} →
                    </a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
        <li class="site-pubs__item">
          <span class="site-pubs__venue">Open Source</span>
          <div class="site-pubs__body">
            <span class="site-pubs__title">astro-blog-template</span>
            <p class="site-pubs__summary">
              <span data-lang="zh">
                本站所使用的开源 Astro 博客模板，面向研究型长文、公式推导教程与技术笔记设计。
              </span>
              <span data-lang="en">
                The open-source Astro template powering this site, designed for
                research articles, math-heavy tutorials, and technical blogs.
              </span>
            </p>
            <div class="site-pubs__links">
              <a
                href="https://github.com/MaoSong2022/astro-blog-template"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub →
              </a>
            </div>
          </div>
        </li>
      </ul>
      <p class="section-more">
        <a href={scholarUrl} target="_blank" rel="noopener noreferrer">
          <span data-lang="zh">在 Google Scholar 查看完整论文列表 →</span>
          <span data-lang="en">Full publication list on Google Scholar →</span>
        </a>
      </p>
    </section>

    <section class="about-section" aria-labelledby="contact-heading">
      <h2 id="contact-heading">
        <span data-lang="zh">联系方式</span>
        <span data-lang="en">Get in Touch</span>
      </h2>
      <div class="contact-section">
        <p data-lang="zh">
          欢迎交流科研合作、技术想法或潜在机会，随时可以通过邮件联系我。
        </p>
        <p data-lang="en">
          I&apos;m always glad to discuss research collaborations, technical
          ideas, or potential opportunities. Feel free to reach out!
        </p>
        <p class="about-email-row">
          <strong>
            <span data-lang="zh">邮箱：</span>
            <span data-lang="en">Email:</span>
          </strong>{" "}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          <button
            type="button"
            class="about-copy-btn"
            data-copy-email={CONTACT_EMAIL}
            aria-label={`Copy ${CONTACT_EMAIL} to clipboard`}
          >
            <span data-lang="zh">复制</span>
            <span data-lang="en">Copy</span>
          </button>
        </p>
        <p>
          <strong>
            <span data-lang="zh">个人简历（CV）：</span>
            <span data-lang="en">Resume / CV:</span>
          </strong>{" "}
          {CV_URL ? (
            <a href={CV_URL} target="_blank" rel="noopener noreferrer">
              <span data-lang="zh">下载 PDF</span>
              <span data-lang="en">Download PDF</span>
            </a>
          ) : (
            <>
              <span data-lang="zh">
                如有需要，欢迎通过 <a href={`mailto:${CONTACT_EMAIL}`}>邮件</a>{" "}
                联系获取。
              </span>
              <span data-lang="en">
                Available upon request via{" "}
                <a href={`mailto:${CONTACT_EMAIL}`}>email</a>.
              </span>
            </>
          )}
        </p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="social-heading">
      <h2 id="social-heading">
        <span data-lang="zh">社交平台</span>
        <span data-lang="en">Find Me Online</span>
      </h2>
      <div class="social-links-section">
        <div class="social-grid">
          <a
            href={scholarUrl}
            class="social-card scholar-card"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="social-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"
                ></path>
              </svg>
            </div>
            <div class="social-info">
              <h3>Google Scholar</h3>
              <p>
                <span data-lang="zh">论文发表与引用记录</span>
                <span data-lang="en">Publications &amp; citations</span>
              </p>
            </div>
          </a>

          <a
            href={githubUrl}
            class="social-card github-card"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="social-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
