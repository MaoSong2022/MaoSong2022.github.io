  <script is:inline>
    (() => {
      const aboutRoot = document.querySelector(".about-page");
      const langBtns = document.querySelectorAll("[data-set-lang]");

      const applyLang = (lang, persist) => {
        const normalized = lang === "en" ? "en" : "zh";
        if (aboutRoot) {
          aboutRoot.setAttribute("data-about-lang", normalized);
        }
        document.documentElement.lang = normalized === "en" ? "en" : "zh-CN";
        langBtns.forEach((btn) => {
          const active = btn.getAttribute("data-set-lang") === normalized;
          btn.setAttribute("aria-pressed", String(active));
        });
        if (persist) {
          try {
            localStorage.setItem("about-lang", normalized);
          } catch {}
        }
      };

      // Priority: ?lang=en|zh query param -> saved preference -> default "zh"
      try {
        const params = new URLSearchParams(window.location.search);
        const queryLang = params.get("lang");
        const savedLang = localStorage.getItem("about-lang");
        if (queryLang === "en" || queryLang === "zh") {
          applyLang(queryLang, false);
        } else if (savedLang === "en" || savedLang === "zh") {
          applyLang(savedLang, false);
        }
      } catch {}

      langBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetLang = btn.getAttribute("data-set-lang");
          if (targetLang) applyLang(targetLang, true);
        });
      });

      // Copy email button
      document.querySelectorAll("[data-copy-email]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const email = btn.getAttribute("data-copy-email");
          if (!email) return;
          const isEn = aboutRoot?.getAttribute("data-about-lang") === "en";
          const zhSpan = btn.querySelector('[data-lang="zh"]');
          const enSpan = btn.querySelector('[data-lang="en"]');
          const origZh = zhSpan?.textContent || "复制";
          const origEn = enSpan?.textContent || "Copy";
          try {
            await navigator.clipboard.writeText(email);
            if (zhSpan) zhSpan.textContent = "已复制!";
            if (enSpan) enSpan.textContent = "Copied!";
            btn.setAttribute("data-copied", "true");
          } catch {
            if (zhSpan) zhSpan.textContent = "复制失败";
            if (enSpan) enSpan.textContent = isEn ? "Copy failed" : "复制失败";
          }
          setTimeout(() => {
            if (zhSpan) zhSpan.textContent = origZh;
            if (enSpan) enSpan.textContent = origEn;
            btn.removeAttribute("data-copied");
          }, 1600);
        });
      });

      // Click-to-toggle WeChat QR card (desktop popover + mobile inline drawer)
      const wechatCard = document.querySelector("[data-wechat-card]");
      const toggleBtn = wechatCard?.querySelector("[data-wechat-toggle]");
      const qrPopup = wechatCard?.querySelector("#wechat-qr-popup");
      if (wechatCard && toggleBtn && qrPopup) {
        const setOpen = (open) => {
          toggleBtn.setAttribute("aria-expanded", String(open));
          wechatCard.classList.toggle("is-open", open);
          qrPopup.hidden = !open;
        };

        toggleBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = toggleBtn.getAttribute("aria-expanded") === "true";
          setOpen(!isOpen);
        });

        document.addEventListener("click", (e) => {
          if (
            toggleBtn.getAttribute("aria-expanded") === "true" &&
            !wechatCard.contains(e.target)
          ) {
            setOpen(false);
          }
        });

        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            toggleBtn.getAttribute("aria-expanded") === "true"
          ) {
            setOpen(false);
            toggleBtn.focus();
          }
        });
      }
    })();
  </script>
