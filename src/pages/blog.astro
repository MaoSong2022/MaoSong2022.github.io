---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import ContentCollections from "../components/ContentCollections.astro";
import CompletionLegend from "../components/CompletionLegend.astro";
import { CONTENT_TYPES, collectionHref, type ContentType } from "../data/article-editorial";
import { parseArticleGlob, sortByCompletion } from "../utils/site-articles";
import { getAllArticleBundleLastModifiedIso } from "../utils/article-modified";
const articleGlob = import.meta.glob<{ frontmatter: Record<string, unknown> }>("../content/*/article.{md,mdx}", { eager: true });
const articles = await parseArticleGlob(articleGlob, await getAllArticleBundleLastModifiedIso());
const order: ContentType[] = ["analysis", "learning", "topics", "reports"];
---
<BaseLayout pageTitle="Articles" description="Explore LLM tutorials, technical reports, topic overviews, and deep dives." contentClass="site-page--blog" lang="en">
  <p class="site-lead">From foundational knowledge to independent analysis. Choose a reading path.</p>
  <ContentCollections articles={articles} />
  <div class="index-tools"><span>{articles.length} articles · Ordered by readiness, then most recently updated</span><a href="/browse">Search & Filter →</a></div>
  <CompletionLegend />
  {order.map(type => {
    const rows = sortByCompletion(articles.filter(a => a.contentType === type));
    return <section aria-labelledby={`heading-${type}`}>
      <h2 id={`heading-${type}`}>{CONTENT_TYPES[type].label} <span class="section-count">{rows.length}</span></h2>
      <p class="section-intro">{CONTENT_TYPES[type].description} <a href={collectionHref(type)}>View Collection →</a></p>
      <ArticleList articles={rows} />
    </section>;
  })}
</BaseLayout>
