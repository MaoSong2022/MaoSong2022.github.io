---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import CompletionLegend from "../components/CompletionLegend.astro";
import { CONTENT_TYPES, COMPLETION, type ContentType, type Completion } from "../data/article-editorial";
import { getDigestSearchText } from "../utils/tech-reports";
import { parseArticleGlob, sortByCompletion, type SiteArticleEntry } from "../utils/site-articles";
import { getAllArticleBundleLastModifiedIso } from "../utils/article-modified";

const articleGlob = import.meta.glob<{ frontmatter: Record<string, unknown> }>(
  "../content/*/article.{md,mdx}",
  { eager: true },
);

const modifiedBySlug = await getAllArticleBundleLastModifiedIso();
const articles = sortByCompletion(await parseArticleGlob(articleGlob, modifiedBySlug));

const categories = [
  ...new Set(articles.map((a) => a.categories).filter(Boolean) as string[]),
].sort((a, b) => a.localeCompare(b));

const allTags = [
  ...new Set(articles.flatMap((a) => a.tags)),
].sort((a, b) => a.localeCompare(b));

type BrowseRow = {
  contentType: ContentType;
  completion: Completion;
  slug: string;
  url: string;
  title: string;
  displayDate: string;
  description: string;
  summary: string;
  categories: string;
  tags: string[];
  extraSearch: string;
};

const browseArticles: BrowseRow[] = articles.map((a: SiteArticleEntry) => ({
  contentType: a.contentType,
  completion: a.completion,
  slug: a.slug,
  url: a.url,
  title: a.title,
  displayDate: a.displayDate ?? "",
  description: a.description ?? "",
  summary: a.summary ?? "",
  categories: a.categories ?? "",
  tags: a.tags,
  extraSearch: getDigestSearchText(a.slug),
}));

const pageTitle = "Browse Articles";
const seoTitle = "Browse LLM Articles by Topic, Status, and Tags";
const description =
  "Search and filter LLM technical articles on Mao Song's blog by content type, reading readiness, subject category, and tags across RL, MLLM, and systems.";
---

<BaseLayout
  pageTitle={pageTitle}
  seoTitle={seoTitle}
  description={description}
  contentClass="site-page--browse"
  lang="en"
>
  <p class="site-lead">
      Choose a content type and reading status, then narrow the results by keyword, subject, or tags.
    </p>

    <CompletionLegend />
    <div class="browse-toolbar" id="browse-toolbar" data-collapsed="false">
      <div class="browse-toolbar-bar">
        <button
          type="button"
          class="browse-toggle"
          id="browse-toggle"
          aria-expanded="true"
          aria-controls="browse-toolbar-body"
        >
          <svg
            class="browse-toggle__icon"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M4 6l4 4 4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span id="browse-toggle-label">Hide Filters</span>
        </button>

        <div
          class="browse-active-chips"
          id="browse-active-chips"
          aria-label="Active filters"
        ></div>

        <div class="browse-toolbar-bar__right">
          <p class="browse-count" id="browse-count" aria-live="polite" />
          <button
            type="button"
            class="browse-clear-inline"
            id="browse-clear"
            hidden
          >
            Clear
          </button>
        </div>
      </div>

      <div class="browse-toolbar-body" id="browse-toolbar-body">
        <div class="editorial-filters">
          <label class="browse-field"><span class="browse-field-label">Content Type</span>
            <select id="browse-type" class="browse-input"><option value="">All Types</option>{Object.entries(CONTENT_TYPES).map(([key, value]) => <option value={key}>{value.label}</option>)}</select>
          </label>
          <label class="browse-field"><span class="browse-field-label">Status</span>
            <select id="browse-completion" class="browse-input"><option value="">All Statuses</option>{Object.entries(COMPLETION).map(([key, value]) => <option value={key}>{value.label}</option>)}</select>
          </label>
        </div>
        <label class="browse-field browse-field--grow">
          <span class="browse-field-label">Search</span>
          <input
            type="search"
            id="browse-q"
            class="browse-input"
            placeholder="Title, description, tags…"
            autocomplete="off"
            enterkeyhint="search"
          />
        </label>

        {
          categories.length > 0 ? (
            <div class="browse-field browse-field--full">
              <span class="browse-field-label" id="browse-categories-label">
                Subjects
              </span>
              <div
                class="browse-tag-row"
                id="browse-categories"
                role="group"
                aria-labelledby="browse-categories-label"
              >
                {categories.map((c) => (
                  <button
                    type="button"
                    class="browse-category"
                    data-category={c}
                    aria-pressed="false"
                  >
                    {c}
                  </button>
                ))}
              </div>
              <p class="browse-tag-hint">
                Select one subject. Click again to clear.
              </p>
            </div>
          ) : null
        }

        {
          allTags.length > 0 ? (
            <div class="browse-field browse-field--full">
              <span class="browse-field-label" id="browse-tags-label">
                Tags
              </span>
              <div
                class="browse-tag-row"
                id="browse-tags"
                role="group"
                aria-labelledby="browse-tags-label"
              >
                {allTags.map((t) => (
                  <button
                    type="button"
                    class="browse-tag"
                    data-tag-norm={t.toLowerCase()}
                    data-tag-label={t}
                    aria-pressed="false"
                  >
                    {t}
                  </button>
                ))}
              </div>
              <p class="browse-tag-hint">
                Articles must include every selected tag.
              </p>
            </div>
          ) : null
        }
      </div>
    </div>

    <p class="browse-empty" id="browse-empty" hidden>
      No matching articles. Try another keyword or clear the filters.
    </p>
    <ArticleList articles={articles} id="browse-list" />

  <script define:vars={{ browseArticles }}>
    const toolbarEl = document.getElementById("browse-toolbar");
    const toolbarBodyEl = document.getElementById("browse-toolbar-body");
    const toggleBtnEl = document.getElementById("browse-toggle");
    const toggleLabelEl = document.getElementById("browse-toggle-label");
    const activeChipsEl = document.getElementById("browse-active-chips");
    const clearBtnEl = document.getElementById("browse-clear");

    function setToolbarCollapsed(collapsed) {
      if (!toolbarEl || !toolbarBodyEl || !toggleBtnEl || !toggleLabelEl) return;
      toolbarEl.dataset.collapsed = collapsed ? "true" : "false";
      toolbarBodyEl.hidden = collapsed;
      toggleBtnEl.setAttribute("aria-expanded", collapsed ? "false" : "true");
      toggleLabelEl.textContent = collapsed ? "Filters" : "Hide Filters";
    }

    function haystack(row) {
      return [
        row.title,
        row.description,
        row.summary,
        row.slug,
        row.categories,
        row.extraSearch,
        ...row.tags,
      ]
        .join(" ")
        .toLowerCase();
    }

    function getSelectedCategory() {
      const pressed = document.querySelector(
        ".browse-category[aria-pressed='true']",
      );
      return pressed?.getAttribute("data-category") ?? "";
    }

    function renderActiveChips({ typeLabel, completionLabel, queryRaw, category, activeTags }) {
      if (!activeChipsEl) return;
      activeChipsEl.textContent = "";

      const addChip = (prefix, label, onRemove) => {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "browse-active-chip";
        chip.title = `Remove ${prefix}: ${label}`;
        chip.setAttribute("aria-label", `Remove ${prefix} ${label}`);

        const text = document.createElement("span");
        text.textContent = prefix ? `${prefix}: ${label}` : label;
        const close = document.createElement("span");
        close.className = "browse-active-chip__x";
        close.setAttribute("aria-hidden", "true");
        close.textContent = "×";

        chip.append(text, close);
        chip.addEventListener("click", onRemove);
        activeChipsEl.appendChild(chip);
      };

      if (typeLabel) {
        addChip("Type", typeLabel, () => {
          const el = document.getElementById("browse-type");
          if (el) el.value = "";
          applyFilters();
        });
      }
      if (completionLabel) {
        addChip("Status", completionLabel, () => {
          const el = document.getElementById("browse-completion");
          if (el) el.value = "";
          applyFilters();
        });
      }
      if (queryRaw) {
        addChip("Search", queryRaw, () => {
          const el = document.getElementById("browse-q");
          if (el instanceof HTMLInputElement) el.value = "";
          applyFilters();
        });
      }
      if (category) {
        addChip("Subject", category, () => {
          document.querySelectorAll(".browse-category[aria-pressed='true']").forEach((btn) =>
            btn.setAttribute("aria-pressed", "false"),
          );
          applyFilters();
        });
      }
      for (const tag of activeTags) {
        addChip("Tag", tag.label, () => {
          tag.btn.setAttribute("aria-pressed", "false");
          applyFilters();
        });
      }
    }

    function applyFilters() {
      const qEl = document.getElementById("browse-q");
      const queryRaw = (qEl instanceof HTMLInputElement ? qEl.value : "").trim();
      const query = queryRaw.toLowerCase();
      const category = getSelectedCategory();
      const typeSelect = document.getElementById("browse-type");
      const completionSelect = document.getElementById("browse-completion");
      const type = typeSelect?.value ?? "";
      const completion = completionSelect?.value ?? "";
      const typeLabel = type && typeSelect ? typeSelect.options[typeSelect.selectedIndex]?.text ?? "" : "";
      const completionLabel = completion && completionSelect ? completionSelect.options[completionSelect.selectedIndex]?.text ?? "" : "";

      const activeNorms = [];
      const activeTags = [];
      document.querySelectorAll(".browse-tag[aria-pressed='true']").forEach(
        (btn) => {
          const n = btn.getAttribute("data-tag-norm");
          const label = btn.getAttribute("data-tag-label") || btn.textContent?.trim() || n;
          if (n) {
            activeNorms.push(n);
            activeTags.push({ norm: n, label, btn });
          }
        },
      );

      let visible = 0;
      const list = document.getElementById("browse-list");
      if (!list) return;

      for (const li of list.querySelectorAll("[data-browse-slug]")) {
        const slug = li.getAttribute("data-browse-slug");
        const row = browseArticles.find((r) => r.slug === slug);
        if (!row) continue;

        let ok = true;
        if (type && row.contentType !== type) ok = false;
        if (completion && row.completion !== completion) ok = false;
        if (query && !haystack(row).includes(query)) ok = false;
        if (category && row.categories !== category) ok = false;
        if (activeNorms.length) {
          const lowered = row.tags.map((t) => t.toLowerCase());
          for (const need of activeNorms) {
            if (!lowered.includes(need)) ok = false;
          }
        }

        li.classList.toggle("browse-hidden", !ok);
        if (ok) visible++;
      }

      const hasActiveFilters = Boolean(
        query || category || type || completion || activeNorms.length > 0,
      );
      if (clearBtnEl) {
        clearBtnEl.hidden = !hasActiveFilters;
      }
      renderActiveChips({
        typeLabel,
        completionLabel,
        queryRaw,
        category,
        activeTags,
      });

      const countEl = document.getElementById("browse-count");
      if (countEl) {
        const total = browseArticles.length;
        countEl.textContent =
          visible === total
            ? `All ${total} articles`
            : `${visible} of ${total} articles`;
      }

      const emptyEl = document.getElementById("browse-empty");
      if (emptyEl) {
        emptyEl.hidden = visible > 0;
      }
      if (list) {
        list.hidden = visible === 0;
      }

      const params = new URLSearchParams();
      if (query) params.set("q", queryRaw);
      if (category) params.set("category", category);
      if (type) params.set("type", type);
      if (completion) params.set("completion", completion);
      for (const tag of activeNorms) params.append("tag", tag);
      const qs = params.toString();
      try {
        window.history.replaceState(
          {},
          "",
          qs ? `${window.location.pathname}?${qs}` : window.location.pathname,
        );
      } catch {}
    }

    function clearFilters() {
      document.getElementById("browse-type").value = "";
      document.getElementById("browse-completion").value = "";
      const qEl = document.getElementById("browse-q");
      if (qEl instanceof HTMLInputElement) qEl.value = "";
      document.querySelectorAll(".browse-category[aria-pressed='true']").forEach(
        (btn) => btn.setAttribute("aria-pressed", "false"),
      );
      document.querySelectorAll(".browse-tag[aria-pressed='true']").forEach(
        (btn) => btn.setAttribute("aria-pressed", "false"),
      );
      applyFilters();
    }

    function applyFiltersFromUrl() {
      let params;
      try {
        params = new URLSearchParams(window.location.search);
      } catch {
        return { hasSubjectOrTag: false };
      }

      let hasSubjectOrTag = false;

      for (const key of ["type", "completion"]) {
        const select = document.getElementById(`browse-${key}`);
        const value = params.get(key) ?? "";
        select.value = [...select.options].some(option => option.value === value) ? value : "";
      }
      const qRaw = params.get("q") ?? params.get("search");
      const qEl = document.getElementById("browse-q");
      if (qRaw && qEl instanceof HTMLInputElement) qEl.value = qRaw;

      const cat = params.get("category");
      if (cat) {
        document.querySelectorAll(".browse-category").forEach((btn) => {
          const v = btn.getAttribute("data-category");
          const matched = v === cat;
          btn.setAttribute("aria-pressed", matched ? "true" : "false");
          if (matched) hasSubjectOrTag = true;
        });
      }

      const tagVals = params.getAll("tag");
      if (tagVals.length) {
        const norms = new Set(
          tagVals.map((t) => t.trim().toLowerCase()).filter(Boolean),
        );
        document.querySelectorAll(".browse-tag").forEach((btn) => {
          const n = btn.getAttribute("data-tag-norm");
          if (n && norms.has(n)) {
            btn.setAttribute("aria-pressed", "true");
            hasSubjectOrTag = true;
          }
        });
      }

      return { hasSubjectOrTag };
    }

    toggleBtnEl?.addEventListener("click", () => {
      const collapsed = toolbarEl?.dataset.collapsed === "true";
      setToolbarCollapsed(!collapsed);
    });

    document.getElementById("browse-q")?.addEventListener("input", applyFilters);

    document.getElementById("browse-categories")?.addEventListener("click", (e) => {
      const btn = e.target?.closest?.(".browse-category");
      if (!btn || !(btn instanceof HTMLElement)) return;
      const pressed = btn.getAttribute("aria-pressed") === "true";
      document.querySelectorAll(".browse-category").forEach((b) =>
        b.setAttribute("aria-pressed", "false"),
      );
      if (!pressed) btn.setAttribute("aria-pressed", "true");
      applyFilters();
      if (!pressed) setToolbarCollapsed(true);
    });

    document.getElementById("browse-tags")?.addEventListener("click", (e) => {
      const btn = e.target?.closest?.(".browse-tag");
      if (!btn || !(btn instanceof HTMLElement)) return;
      const pressed = btn.getAttribute("aria-pressed") === "true";
      btn.setAttribute("aria-pressed", pressed ? "false" : "true");
      applyFilters();
      if (!pressed) setToolbarCollapsed(true);
    });

    clearBtnEl?.addEventListener("click", clearFilters);

    for (const id of ["browse-type", "browse-completion"]) {
      document.getElementById(id)?.addEventListener("change", applyFilters);
    }

    const { hasSubjectOrTag } = applyFiltersFromUrl();
    applyFilters();
    if (hasSubjectOrTag) {
      setToolbarCollapsed(true);
    }
  </script>

  <style>
    .browse-toolbar {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }

    .browse-toolbar-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--spacing-2) var(--spacing-3);
      padding: var(--spacing-2) var(--spacing-4);
      min-height: 46px;
    }

    .browse-toolbar[data-collapsed="false"] .browse-toolbar-bar {
      border-bottom: 1px solid var(--border-color);
    }

    button.browse-toggle {
      appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 0;
      margin: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--text-color);
      font: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.4;
      cursor: pointer;
      filter: none;
      transform: none;
      transition: color 0.15s ease;
    }

    button.browse-toggle:hover {
      color: var(--primary-color);
      filter: none;
    }

    button.browse-toggle:active {
      transform: none;
    }

    button.browse-toggle:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 3px;
      border-radius: 4px;
    }

    .browse-toggle__icon {
      display: block;
      width: 14px;
      height: 14px;
      color: var(--muted-color);
      transition: transform 0.18s ease, color 0.15s ease;
    }

    button.browse-toggle:hover .browse-toggle__icon {
      color: var(--primary-color);
    }

    .browse-toolbar[data-collapsed="true"] .browse-toggle__icon {
      transform: rotate(-90deg);
    }

    .browse-active-chips {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      min-width: 0;
      flex: 1 1 auto;
    }

    .browse-active-chips:empty {
      display: none;
    }

    :global(button.browse-active-chip) {
      appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 9px;
      margin: 0;
      font: inherit;
      font-size: 0.8125rem;
      font-weight: 500;
      line-height: 1.45;
      color: var(--primary-color);
      background: color-mix(in srgb, var(--primary-color) 10%, var(--page-bg));
      border: 1px solid color-mix(in srgb, var(--primary-color) 35%, var(--border-color));
      border-radius: 999px;
      cursor: pointer;
      filter: none;
      transform: none;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    :global(button.browse-active-chip:hover) {
      border-color: var(--primary-color);
      background: color-mix(in srgb, var(--primary-color) 16%, var(--page-bg));
      filter: none;
    }

    :global(button.browse-active-chip:active) {
      transform: none;
    }

    :global(.browse-active-chip__x) {
      font-size: 0.95em;
      line-height: 1;
      opacity: 0.75;
    }

    .browse-toolbar-bar__right {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-3);
      margin-left: auto;
      flex-shrink: 0;
    }

    button.browse-clear-inline {
      appearance: none;
      padding: 3px 10px;
      margin: 0;
      font: inherit;
      font-size: 0.8125rem;
      font-weight: 500;
      line-height: 1.4;
      color: var(--muted-color);
      background: transparent;
      border: 1px solid var(--border-color);
      border-radius: var(--button-radius);
      cursor: pointer;
      filter: none;
      transform: none;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    button.browse-clear-inline:hover {
      color: var(--primary-color);
      border-color: color-mix(in srgb, var(--primary-color) 45%, var(--border-color));
      filter: none;
    }

    button.browse-clear-inline:active {
      transform: none;
    }

    button.browse-clear-inline[hidden] {
      display: none;
    }

    .browse-toolbar-body {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-4);
      padding: var(--spacing-4);
    }

    .browse-toolbar-body[hidden] {
      display: none;
    }
  </style>

</BaseLayout>
