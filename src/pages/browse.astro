---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import CompletionLegend from "../components/CompletionLegend.astro";
import { CONTENT_TYPES, COMPLETION, type ContentType, type Completion } from "../data/article-editorial";
import { parseArticleGlob, sortByCompletion, type SiteArticleEntry } from "../utils/site-articles";
import { getAllArticleBundleLastModifiedIso } from "../utils/article-modified";

const articleGlob = import.meta.glob<{ frontmatter: Record<string, unknown> }>(
  "../content/*/article.{md,mdx}",
  { eager: true },
);

const modifiedBySlug = await getAllArticleBundleLastModifiedIso();
const articles = sortByCompletion(await parseArticleGlob(articleGlob, modifiedBySlug));

const categories = [
  ...new Set(articles.map((a) => a.categories).filter(Boolean) as string[]),
].sort((a, b) => a.localeCompare(b));

const allTags = [
  ...new Set(articles.flatMap((a) => a.tags)),
].sort((a, b) => a.localeCompare(b));

type BrowseRow = {
  contentType: ContentType;
  completion: Completion;
  slug: string;
  url: string;
  title: string;
  displayDate: string;
  description: string;
  summary: string;
  categories: string;
  tags: string[];
};

const browseArticles: BrowseRow[] = articles.map((a: SiteArticleEntry) => ({
  contentType: a.contentType,
  completion: a.completion,
  slug: a.slug,
  url: a.url,
  title: a.title,
  displayDate: a.displayDate ?? "",
  description: a.description ?? "",
  summary: a.summary ?? "",
  categories: a.categories ?? "",
  tags: a.tags,
}));

const pageTitle = "Browse Articles";
const description =
  "Search articles by content type, status, subject, and tags.";
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  contentClass="site-page--browse"
  lang="en"
>
  <p class="site-lead">
      Choose a content type and reading status, then narrow the results by keyword, subject, or tags.
    </p>

    <CompletionLegend />
    <div class="browse-toolbar">
      <div class="editorial-filters">
        <label class="browse-field"><span class="browse-field-label">Content Type</span>
          <select id="browse-type" class="browse-input"><option value="">All Types</option>{Object.entries(CONTENT_TYPES).map(([key, value]) => <option value={key}>{value.label}</option>)}</select>
        </label>
        <label class="browse-field"><span class="browse-field-label">Status</span>
          <select id="browse-completion" class="browse-input"><option value="">All Statuses</option>{Object.entries(COMPLETION).map(([key, value]) => <option value={key}>{value.label}</option>)}</select>
        </label>
      </div>
      <label class="browse-field browse-field--grow">
        <span class="browse-field-label">Search</span>
        <input
          type="search"
          id="browse-q"
          class="browse-input"
          placeholder="Title, description, tags…"
          autocomplete="off"
          enterkeyhint="search"
        />
      </label>

      {
        categories.length > 0 ? (
          <div class="browse-field browse-field--full">
            <span class="browse-field-label" id="browse-categories-label">
              Subjects
            </span>
            <div
              class="browse-tag-row"
              id="browse-categories"
              role="group"
              aria-labelledby="browse-categories-label"
            >
              {categories.map((c) => (
                <button
                  type="button"
                  class="browse-category"
                  data-category={c}
                  aria-pressed="false"
                >
                  {c}
                </button>
              ))}
            </div>
            <p class="browse-tag-hint">
              Select one subject. Click again to clear.
            </p>
          </div>
        ) : null
      }

      {
        allTags.length > 0 ? (
          <div class="browse-field browse-field--full">
            <span class="browse-field-label" id="browse-tags-label">
              Tags
            </span>
            <div
              class="browse-tag-row"
              id="browse-tags"
              role="group"
              aria-labelledby="browse-tags-label"
            >
              {allTags.map((t) => (
                <button
                  type="button"
                  class="browse-tag"
                  data-tag-norm={t.toLowerCase()}
                  aria-pressed="false"
                >
                  {t}
                </button>
              ))}
            </div>
            <p class="browse-tag-hint">
              Articles must include every selected tag.
            </p>
          </div>
        ) : null
      }

      <div class="browse-toolbar-actions">
        <button type="button" class="button button--ghost browse-clear" id="browse-clear">
          Clear Filters
        </button>
        <p class="browse-count" id="browse-count" aria-live="polite" />
      </div>
    </div>

    <p class="browse-empty" id="browse-empty" hidden>
      No matching articles. Try another keyword or clear the filters.
    </p>
    <ArticleList articles={articles} id="browse-list" />

  <script define:vars={{ browseArticles }}>
    function haystack(row) {
      return [
        row.title,
        row.description,
        row.summary,
        row.slug,
        row.categories,
        ...row.tags,
      ]
        .join(" ")
        .toLowerCase();
    }

    function getSelectedCategory() {
      const pressed = document.querySelector(
        ".browse-category[aria-pressed='true']",
      );
      return pressed?.getAttribute("data-category") ?? "";
    }

    function applyFilters() {
      const qEl = document.getElementById("browse-q");
      const query = (qEl instanceof HTMLInputElement ? qEl.value : "")
        .trim()
        .toLowerCase();
      const category = getSelectedCategory();
      const type = document.getElementById("browse-type").value;
      const completion = document.getElementById("browse-completion").value;

      const activeNorms = [];
      document.querySelectorAll(".browse-tag[aria-pressed='true']").forEach(
        (btn) => {
          const n = btn.getAttribute("data-tag-norm");
          if (n) activeNorms.push(n);
        },
      );

      let visible = 0;
      const list = document.getElementById("browse-list");
      if (!list) return;

      for (const li of list.querySelectorAll("[data-browse-slug]")) {
        const slug = li.getAttribute("data-browse-slug");
        const row = browseArticles.find((r) => r.slug === slug);
        if (!row) continue;

        let ok = true;
        if (type && row.contentType !== type) ok = false;
        if (completion && row.completion !== completion) ok = false;
        if (query && !haystack(row).includes(query)) ok = false;
        if (category && row.categories !== category) ok = false;
        if (activeNorms.length) {
          const lowered = row.tags.map((t) => t.toLowerCase());
          for (const need of activeNorms) {
            if (!lowered.includes(need)) ok = false;
          }
        }

        li.classList.toggle("browse-hidden", !ok);
        if (ok) visible++;
      }

      const countEl = document.getElementById("browse-count");
      if (countEl) {
        const total = browseArticles.length;
        countEl.textContent =
          visible === total
            ? `All ${total} articles`
            : `${visible} of ${total} articles`;
      }

      const emptyEl = document.getElementById("browse-empty");
      if (emptyEl) {
        emptyEl.hidden = visible > 0;
      }
      if (list) {
        list.hidden = visible === 0;
      }

      const params = new URLSearchParams();
      if (query) params.set("q", qEl instanceof HTMLInputElement ? qEl.value : query);
      if (category) params.set("category", category);
      if (type) params.set("type", type);
      if (completion) params.set("completion", completion);
      for (const tag of activeNorms) params.append("tag", tag);
      const qs = params.toString();
      try {
        window.history.replaceState(
          {},
          "",
          qs ? `${window.location.pathname}?${qs}` : window.location.pathname,
        );
      } catch {}
      }

    function clearFilters() {
      document.getElementById("browse-type").value = "";
      document.getElementById("browse-completion").value = "";
      const qEl = document.getElementById("browse-q");
      if (qEl instanceof HTMLInputElement) qEl.value = "";
      document.querySelectorAll(".browse-category[aria-pressed='true']").forEach(
        (btn) => btn.setAttribute("aria-pressed", "false"),
      );
      document.querySelectorAll(".browse-tag[aria-pressed='true']").forEach(
        (btn) => btn.setAttribute("aria-pressed", "false"),
      );
      applyFilters();
    }

    function applyFiltersFromUrl() {
      let params;
      try {
        params = new URLSearchParams(window.location.search);
      } catch {
        return;
      }

      for (const key of ["type", "completion"]) {
        const select = document.getElementById(`browse-${key}`);
        const value = params.get(key) ?? "";
        select.value = [...select.options].some(option => option.value === value) ? value : "";
      }
      const qRaw = params.get("q") ?? params.get("search");
      const qEl = document.getElementById("browse-q");
      if (qRaw && qEl instanceof HTMLInputElement) qEl.value = qRaw;

      const cat = params.get("category");
      if (cat) {
        document.querySelectorAll(".browse-category").forEach((btn) => {
          const v = btn.getAttribute("data-category");
          btn.setAttribute("aria-pressed", v === cat ? "true" : "false");
        });
      }

      const tagVals = params.getAll("tag");
      if (tagVals.length) {
        const norms = new Set(
          tagVals.map((t) => t.trim().toLowerCase()).filter(Boolean),
        );
        document.querySelectorAll(".browse-tag").forEach((btn) => {
          const n = btn.getAttribute("data-tag-norm");
          if (n && norms.has(n)) btn.setAttribute("aria-pressed", "true");
        });
      }
    }

    document.getElementById("browse-q")?.addEventListener("input", applyFilters);

    document.getElementById("browse-categories")?.addEventListener("click", (e) => {
      const btn = e.target?.closest?.(".browse-category");
      if (!btn || !(btn instanceof HTMLElement)) return;
      const pressed = btn.getAttribute("aria-pressed") === "true";
      document.querySelectorAll(".browse-category").forEach((b) =>
        b.setAttribute("aria-pressed", "false"),
      );
      if (!pressed) btn.setAttribute("aria-pressed", "true");
      applyFilters();
    });

    document.getElementById("browse-tags")?.addEventListener("click", (e) => {
      const btn = e.target?.closest?.(".browse-tag");
      if (!btn || !(btn instanceof HTMLElement)) return;
      const pressed = btn.getAttribute("aria-pressed") === "true";
      btn.setAttribute("aria-pressed", pressed ? "false" : "true");
      applyFilters();
    });

    document.getElementById("browse-clear")?.addEventListener("click", clearFilters);

    for (const id of ["browse-type", "browse-completion"]) {
      document.getElementById(id)?.addEventListener("change", applyFilters);
    }
    applyFiltersFromUrl();
    applyFilters();
  </script>

</BaseLayout>
