---
import ArticlePage from "../../../layouts/ArticlePage.astro";
import { getArticleBundleLastModifiedIso } from "../../../utils/article-modified";
import { getArticleBundleReadingTime } from "../../../utils/reading-time";

export async function getStaticPaths() {
  const loaders = import.meta.glob("../../../content/*/article.{md,mdx}");
  const entries = await Promise.all(
    Object.entries(loaders).map(async ([path, load]) => {
      const match = path.match(/content\/([^/]+)\/article\.(?:md|mdx)$/);
      if (!match) return null;
      const slug = match[1];
      if (slug === "demo") return null;
      const [articleMod, lastModified, readingTime] = await Promise.all([
        load(),
        getArticleBundleLastModifiedIso(slug),
        getArticleBundleReadingTime(slug),
      ]);
      return {
        params: { slug },
        props: { articleMod, lastModified, readingTime },
      };
    }),
  );
  return entries.filter(
    (e): e is NonNullable<typeof e> => e !== null,
  );
}

const { articleMod, lastModified, readingTime } = Astro.props;
const { slug } = Astro.params;
---

<ArticlePage
  articleMod={articleMod as any}
  lastModified={lastModified}
  readingTime={readingTime}
  slug={slug}
/>
