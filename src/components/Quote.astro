---
interface Props {
    author?: string;
    source?: string;
}

const { author, source } = Astro.props;
---

<blockquote class="quote">
    <div class="quote__text">
        <slot />
    </div>
    {
        (author || source) && (
            <footer class="quote__footer">
                <span class="quote__attribution">
                    {author && <span class="quote__author" set:html={author} />}
                    {author && source && <span class="quote__separator">, </span>}
                    {source && <span class="quote__source" set:html={source} />}
                </span>
            </footer>
        )
    }
</blockquote>

<style>
    .quote {
        font-family: var(--default-font-family);
        position: relative;
        margin: var(--block-spacing-y) 0;
        padding: 18px 24px 16px 22px;
        border: none;
        border-left: 3px solid var(--primary-color);
        border-radius: 0 8px 8px 0;
        background: var(--surface-bg);
        box-shadow: none;
        text-align: left;
        font-style: normal;
        color: var(--text-color);
        white-space: normal;
        overflow: hidden;
    }

    .quote::before {
        content: "\201C";
        position: absolute;
        top: 2px;
        right: 16px;
        font-size: 4.5rem;
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 700;
        color: var(--primary-color);
        opacity: 0.14;
        line-height: 1;
        pointer-events: none;
        user-select: none;
    }

    .quote__text {
        position: relative;
        font-size: 1.0625rem;
        line-height: 1.65;
        font-style: normal;
        font-weight: 400;
        font-family: var(--default-font-family);
        color: var(--text-color);
        padding: 0;
    }

    .quote__text :global(p) {
        margin: 0 0 0.75em;
    }

    .quote__text :global(p:last-child) {
        margin-bottom: 0;
    }

    .quote__footer {
        position: relative;
        margin-top: 12px;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--muted-color);
        display: flex;
        align-items: baseline;
        gap: 6px;
        font-family: var(--default-font-family);
        font-style: normal;
    }

    .quote__footer::before {
        content: "—";
        color: var(--muted-color);
        opacity: 0.7;
        flex-shrink: 0;
    }

    .quote__attribution {
        min-width: 0;
    }

    .quote__author {
        font-weight: 600;
        font-style: normal;
        color: var(--text-color);
    }

    .quote__separator {
        color: var(--muted-color);
    }

    .quote__source {
        font-weight: 400;
        font-style: italic;
        color: var(--muted-color);
    }

    .quote__footer :global(a) {
        background: transparent;
    }

    @media (max-width: 640px) {
        .quote {
            margin: 20px 0;
            padding: 16px 18px 14px 18px;
        }

        .quote::before {
            font-size: 3.5rem;
            top: 4px;
            right: 12px;
        }

        .quote__text {
            font-size: 1rem;
            line-height: 1.6;
        }

        .quote__footer {
            margin-top: 10px;
            font-size: 0.8125rem;
        }
    }
</style>
