---
import { GITHUB_USERNAME } from "../consts";

interface RelatedArticle {
  slug: string;
  url: string;
  title: string;
  description?: string;
  contentTypeLabel?: string;
}

interface Props {
  citationText: string;
  bibtex: string;
  licence?: string;
  doi?: string;
  template?: string;
  articleTitle?: string;
  articleUrl?: string;
  slug?: string;
  relatedArticles?: RelatedArticle[];
}
const {
  citationText,
  bibtex,
  licence,
  doi,
  template = "article",
  articleTitle = "",
  articleUrl = "",
  slug,
  relatedArticles = [],
} = Astro.props as Props;
const isPaper = template === "paper";
const shareOnXUrl = articleUrl
  ? `https://x.com/intent/tweet?text=${encodeURIComponent(articleTitle)}&url=${encodeURIComponent(articleUrl)}`
  : undefined;
---

<footer class="footer">
  <div class="footer-inner">
    {relatedArticles.length > 0 && (
      <section class="related-block" aria-label="Related articles">
        <p class="footer-heading" role="heading" aria-level="2">Related</p>
        <ul class="related-list">
          {relatedArticles.map((item) => (
            <li class="related-item">
              <a class="related-item__title" href={item.url}>{item.title}</a>
              {item.contentTypeLabel && (
                <span class="related-item__badge">{item.contentTypeLabel}</span>
              )}
              {item.description && (
                <p class="related-item__desc">{item.description}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
    <section class="engage-block" aria-label="Share and follow">
      <p class="footer-heading" role="heading" aria-level="2">Share &amp; Follow</p>
      <div class="engage-body">
        <div class="engage-actions">
          <button
            type="button"
            class="engage-btn"
            data-copy-article-link={articleUrl}
          >
            Copy link
          </button>
          {shareOnXUrl && (
            <a
              class="engage-btn"
              href={shareOnXUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Share on X
            </a>
          )}
          {slug && (
            <a class="engage-btn" href={`/blog/${slug}/llms.txt`}>
              Markdown (llms.txt)
            </a>
          )}
        </div>
        <div class="engage-follow">
          <span class="engage-follow__label">关注「以往的月」：</span>
          <details class="engage-wechat">
            <summary>微信公众号</summary>
            <div class="engage-wechat__popover">
              <img
                src="/wechat_avatar.jpg"
                alt="微信公众号「以往的月」二维码"
                width="144"
                height="144"
                loading="lazy"
                decoding="async"
              />
              <span>微信扫码关注</span>
            </div>
          </details>
          <span aria-hidden="true">·</span>
          <a href="https://b23.tv/a0Bb9Z1" target="_blank" rel="noopener noreferrer">Bilibili</a>
          <span aria-hidden="true">·</span>
          <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </section>
    {!isPaper && (
      <section class="citation-block">
        <p class="footer-heading" role="heading" aria-level="2">Citation</p>
        <p>For attribution in academic contexts, please cite this work as</p>
        <pre class="citation short">{citationText}</pre>

        <p>BibTeX citation</p>
        <pre class="citation long">{bibtex}</pre>
      </section>
    )}
    {!isPaper &&
      doi && (
        <section class="doi-block">
          <p class="footer-heading" role="heading" aria-level="2">DOI</p>
          <p>
            <a
              href={`https://doi.org/${doi}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {doi}
            </a>
          </p>
        </section>
      )
    }
    {
      licence && (
        <section class="reuse-block">
          <p class="footer-heading" role="heading" aria-level="2">Reuse</p>
          <p set:html={licence} />
        </section>
      )
    }
    <section class="references-block">
      <slot />
    </section>
    <div class="template-credit">
      <p>
        Made with ❤️ with <a
          href="https://huggingface.co/spaces/tfrere/research-article-template"
          target="_blank"
          rel="noopener noreferrer">research article template</a
        >
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const getFooter = () =>
      document.currentScript?.closest("footer") ||
      document.querySelector("footer.footer");
    const footer = getFooter();
    if (!footer) return;
    // Copy article link handler
    footer.querySelectorAll("[data-copy-article-link]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.getAttribute("data-copy-article-link") || window.location.href;
        const original = btn.textContent || "Copy link";
        try {
          await navigator.clipboard.writeText(url);
          btn.textContent = "Copied!";
          setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        } catch {
          btn.textContent = "Copy failed";
          setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        }
      });
    });

    const target = footer.querySelector(".references-block");
    if (!target) return;

    const contentRoot =
      document.querySelector("section.content-grid main") ||
      document.querySelector("main") ||
      document.body;

    const ensureHeading = (text) => {
      const exists = Array.from(target.children).some(
        (c) =>
          c.classList.contains("footer-heading") &&
          c.textContent.trim().toLowerCase() === text.toLowerCase(),
      );
      if (!exists) {
        const h = document.createElement("p");
        h.className = "footer-heading";
        h.setAttribute("role", "heading");
        h.setAttribute("aria-level", "2");
        h.textContent = text;
        target.appendChild(h);
      }
    };

    const moveIntoFooter = (element, headingText) => {
      if (!element) return false;

      // Remove an eventual heading already included inside the block (avoid duplicates)
      const firstHeading = element.querySelector(
        ":scope > h1, :scope > h2, :scope > h3, :scope > .footer-heading",
      );
      if (firstHeading) {
        const txt = (firstHeading.textContent || "").trim().toLowerCase();
        const targetTxt = headingText.trim().toLowerCase();
        if (
          txt === targetTxt ||
          txt.includes("reference") ||
          txt.includes("bibliograph")
        ) {
          firstHeading.remove();
        }
      }

      // Move footnote backref links inside paragraphs BEFORE moving element
      if (element.classList && element.classList.contains("footnotes")) {
        const footnoteItems = element.querySelectorAll("li");
        footnoteItems.forEach((item) => {
          const backrefContainer = item.querySelector("small.backrefs");
          const lastP = item.querySelector("p:last-of-type");
          if (backrefContainer && lastP && !lastP.contains(backrefContainer)) {
            lastP.appendChild(document.createTextNode(" "));
            lastP.appendChild(backrefContainer);
          }
        });
      }

      ensureHeading(headingText);

      // Move element directly - this preserves KaTeX DOM structure and inline styles
      // KaTeX is already rendered at build-time, so we just need to preserve the HTML
      target.appendChild(element);

      return true;
    };

    const stripLeadingOrdinal = (root) => {
      if (!root) return;
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      const firstText = walker.nextNode();
      if (!firstText || typeof firstText.textContent !== "string") return;
      firstText.textContent = firstText.textContent.replace(/^\s*\d+\.\s*/, "");
    };

    const extractFirstRefId = (el) => {
      if (!el) return "";
      if (el.id) return el.id;
      const nested = el.querySelector("[id]");
      return nested?.id || "";
    };

    const normalizeReferenceItem = (item) => {
      if (!item) return null;
      const li = document.createElement("li");
      const cloned = item.cloneNode(true);
      const itemId = extractFirstRefId(item);
      if (itemId) li.id = itemId;

      // Remove CSL left margin numbers to avoid duplicate/colliding numbering.
      cloned.querySelectorAll(".csl-left-margin").forEach((n) => n.remove());
      const inline = cloned.querySelector(".csl-right-inline");
      const contentRoot = inline || cloned;

      const childNodes = Array.from(contentRoot.childNodes || []);
      if (childNodes.length > 0) {
        childNodes.forEach((n) => li.appendChild(n.cloneNode(true)));
      } else {
        li.textContent = contentRoot.textContent || "";
      }

      stripLeadingOrdinal(li);
      const hasMeaningfulText = (li.textContent || "").replace(/\s+/g, "").length > 0;
      const hasLink = li.querySelector("a") != null;
      if (!hasMeaningfulText && !hasLink) return null;
      return li;
    };

    const extractReferenceItems = (container) => {
      if (!container) return [];
      const items = [];

      if (container.tagName === "OL") {
        container.querySelectorAll(":scope > li").forEach((li) => {
          const normalized = normalizeReferenceItem(li);
          if (normalized) items.push(normalized);
        });
        return items;
      }

      const cslEntries = container.querySelectorAll(".csl-entry");
      if (cslEntries.length > 0) {
        cslEntries.forEach((entry) => {
          const normalized = normalizeReferenceItem(entry);
          if (normalized) items.push(normalized);
        });
        return items;
      }

      const listItems = container.querySelectorAll("li");
      if (listItems.length > 0) {
        listItems.forEach((li) => {
          const normalized = normalizeReferenceItem(li);
          if (normalized) items.push(normalized);
        });
        return items;
      }

      Array.from(container.children || []).forEach((child) => {
        const normalized = normalizeReferenceItem(child);
        if (normalized) items.push(normalized);
      });
      return items;
    };

    const normalizeRefText = (text) =>
      String(text || "")
        .replace(/^\s*\d+\.\s*/, "")
        .replace(/\s+/g, " ")
        .trim()
        .toLowerCase();

    const dedupeKeyForRef = (li) => {
      const id = li.id || "";
      if (id) return `id:${id}`;
      const href = li.querySelector('a[href^="http"]')?.getAttribute("href");
      if (href) return `url:${href.trim().toLowerCase()}`;
      return `txt:${normalizeRefText(li.textContent)}`;
    };

    const buildMergedReferencesBlock = (refContainers) => {
      if (!Array.isArray(refContainers) || refContainers.length === 0) return null;
      const mergedOl = document.createElement("ol");
      mergedOl.className = "references";
      const seen = new Set();

      refContainers.forEach((container) => {
        const items = extractReferenceItems(container);
        items.forEach((item) => {
          const key = dedupeKeyForRef(item);
          if (seen.has(key)) return;
          seen.add(key);
          mergedOl.appendChild(item);
        });
      });

      if (mergedOl.children.length === 0) return null;
      const section = document.createElement("section");
      section.id = "references";
      section.setAttribute("data-merged-references", "1");
      section.appendChild(mergedOl);
      return section;
    };

    const run = () => {
      // Prevent multiple runs
      if (footer.dataset.processed === "true") return false;

      const findAllOutsideFooter = (selectors) => {
        // Find ALL matching elements outside the footer (not just the first)
        const results = [];
        const searchRoots = [contentRoot, document.body].filter(Boolean);

        for (const root of searchRoots) {
          for (const sel of selectors) {
            const elements = root.querySelectorAll(sel);
            elements.forEach((el) => {
              if (el && !footer.contains(el) && !results.includes(el)) {
                results.push(el);
              }
            });
          }
        }
        return results;
      };

      const findFirstOutsideFooter = (selectors) => {
        const all = findAllOutsideFooter(selectors);
        return all.length > 0 ? all[0] : null;
      };

      // Move ALL references from content to footer (handles duplicate bibliography issue)
      const allRefsEls = findAllOutsideFooter([
        "#bibliography-references-list",
        "[data-bibliography-block]",
        "#references",
        "#refs",
        ".references:not(ol.references)", // Avoid selecting normalized <ol> inside the container
        ".bibliography",
      ]);

      // Try multiple selectors for footnotes
      const footnotesEl = findFirstOutsideFooter([
        "[data-built-footnotes]",
        ".footnotes",
        "section.footnotes",
        "div.footnotes",
      ]);

      // Merge all bibliography fragments into a single ordered list.
      let movedRefs = false;
      const mergedRefsEl = buildMergedReferencesBlock(allRefsEls);
      if (mergedRefsEl) {
        ensureHeading("References");
        target.appendChild(mergedRefsEl);
        allRefsEls.forEach((el) => el.remove());
        movedRefs = true;
      }

      const movedNotes = moveIntoFooter(footnotesEl, "Footnotes");

      if (movedRefs || movedNotes) {
        footer.dataset.processed = "true";
      }

      return movedRefs || movedNotes;
    };

    // Try multiple times to catch footnotes at different stages
    const attemptMove = () => {
      run();
    };

    // Try immediately
    attemptMove();

    // Try on DOMContentLoaded
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", attemptMove, {
        once: true,
      });
    }

    // Try on window load
    window.addEventListener(
      "load",
      () => {
        setTimeout(attemptMove, 100);
      },
      { once: true },
    );

    // Final attempt after a short delay
    setTimeout(attemptMove, 300);

    // Resize on window changes (e.g., fonts, layout)
    // No textarea auto-resize needed for <pre> blocks
  })();
</script>

<style is:global>
  .footer {
    contain: layout style;
    font-size: 0.8em;
    line-height: 1.7em;
    margin-top: 60px;
    margin-bottom: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    color: rgba(0, 0, 0, 0.5);
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 60px 16px 48px;
    display: grid;
    grid-template-columns: 220px minmax(0, 680px) 260px;
    gap: 32px;
    align-items: start;
  }

  /* Use the parent grid (3 columns like .content-grid) */
  .related-block,
  .engage-block,
  .citation-block,
  .references-block,
  .reuse-block,
  .doi-block {
    display: contents;
  }

  .related-block > .footer-heading,
  .engage-block > .footer-heading,
  .citation-block > .footer-heading,
  .references-block > .footer-heading,
  .reuse-block > .footer-heading,
  .doi-block > .footer-heading {
    grid-column: 1;
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    text-align: right;
    padding-right: 30px;
  }

  .related-block > :not(.footer-heading),
  .engage-block > :not(.footer-heading),
  .citation-block > :not(.footer-heading),
  .references-block > :not(.footer-heading),
  .reuse-block > :not(.footer-heading),
  .doi-block > :not(.footer-heading) {
    grid-column: 2;
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .related-item {
    padding: 12px 14px;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.015);
  }

  .related-item__title {
    font-size: 1.05em;
    font-weight: 600;
    margin-right: 8px;
  }

  .related-item__badge {
    display: inline-block;
    font-size: 0.78em;
    padding: 1px 7px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    color: rgba(0, 0, 0, 0.65);
    vertical-align: middle;
  }

  .related-item__desc {
    margin: 5px 0 0;
    font-size: 0.92em;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.6);
  }

  .engage-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .engage-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .engage-btn {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    font-size: 0.92em;
    line-height: 1.5;
    border-radius: 5px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    background: transparent;
    color: var(--text-color);
    cursor: pointer;
    text-decoration: none;
  }

  .footer a.engage-btn {
    color: var(--text-color);
    border: 1px solid rgba(0, 0, 0, 0.14);
  }

  .engage-btn:hover,
  .footer a.engage-btn:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  .engage-follow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.95em;
  }

  .engage-follow__label {
    color: rgba(0, 0, 0, 0.6);
  }

  .engage-wechat {
    position: relative;
    display: inline-block;
  }

  .engage-wechat summary {
    cursor: pointer;
    color: var(--primary-color);
    list-style: none;
    border-bottom: 1px solid var(--link-underline);
  }

  .engage-wechat summary::-webkit-details-marker {
    display: none;
  }

  .engage-wechat__popover {
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    z-index: 20;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: var(--page-bg, #fff);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 0.85em;
    color: var(--text-color);
    width: 166px;
  }

  .engage-wechat__popover img {
    display: block;
    border-radius: 4px;
  }

  [data-theme="dark"] .related-item {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }

  [data-theme="dark"] .related-item__badge {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(220, 220, 220, 0.85);
  }

  [data-theme="dark"] .related-item__desc,
  [data-theme="dark"] .engage-follow__label {
    color: rgba(200, 200, 200, 0.72);
  }

  [data-theme="dark"] .engage-btn,
  [data-theme="dark"] .footer a.engage-btn {
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(235, 235, 235, 0.9);
  }

  [data-theme="dark"] .engage-wechat__popover {
    border-color: rgba(255, 255, 255, 0.18);
    background: var(--page-bg, #161b22);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .citation-block .footer-heading {
    margin: 0 0 8px;
  }

  .citation-block h4 {
    margin: 16px 0 8px;
    font-size: 14px;
    text-transform: uppercase;
    color: var(--muted-color);
  }

  .citation-block p,
  .reuse-block p,
  .doi-block p,
  .footnotes ol,
  .footnotes ol p,
  .references {
    margin-top: 0;
  }

  /* Preserve KaTeX rendering in footnotes - essential for math formulas */
  /* Compensate for footer's 0.8em font-size */
  .footer .footnotes .katex {
    font-size: 1.25em; /* 1em / 0.8em = 1.25em to compensate */
    line-height: 1.21;
  }

  .footer .footnotes .katex-display {
    margin: 1em 0;
    text-align: center;
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .footer .footnotes .katex-display > .katex {
    display: block;
    text-align: center;
  }

  /* Preserve KaTeX internal structure */
  .footer .footnotes .katex .katex-html {
    display: inline-block;
  }

  .footer .footnotes .katex .base {
    display: inline-block;
  }

  /* Distill-like appendix citation styling */
  .citation {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    font-size: 11px;
    line-height: 15px;
    border-left: 1px solid rgba(0, 0, 0, 0.1);
    padding-left: 18px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: rgba(0, 0, 0, 0.02);
    padding: 10px 18px;
    border-radius: 3px;
    color: rgba(150, 150, 150, 1);
    overflow: hidden;
    margin-top: -12px;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .citation a {
    color: rgba(0, 0, 0, 0.6);
    text-decoration: underline;
  }

  .citation.short {
    margin-top: -4px;
  }

  .references-block .footer-heading {
    margin: 0;
  }

  /* Distill-like list styling for references/footnotes */
  .references-block ol {
    padding: 0 0 0 15px;
  }

  @media (min-width: 768px) {
    .references-block ol {
      padding: 0 0 0 30px;
      margin-left: -30px;
    }
  }

  .references-block li {
    margin-bottom: 1em;
  }

  .references-block a {
    color: var(--text-color);
  }

  [data-theme="dark"] .footer {
    border-top-color: rgba(255, 255, 255, 0.15);
    color: rgba(200, 200, 200, 0.8);
  }
  [data-theme="dark"] .citation {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(200, 200, 200, 1);
  }
  [data-theme="dark"] .citation a {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Footer links: use primary color consistently */
  .footer a {
    color: var(--primary-color);
    border-bottom: 1px solid var(--link-underline);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--primary-color-hover);
    border-bottom-color: var(--link-underline-hover);
  }
  [data-theme="dark"] .footer a {
    color: var(--primary-color);
  }

  /* Template credit - discrete at the bottom */
  .template-credit {
    display: contents;
  }

  .template-credit p {
    grid-column: 2;
    margin: 24px 0 0 0;
    font-size: 0.85em;
    color: rgba(0, 0, 0, 0.5);
  }

  .template-credit a {
    color: rgba(0, 0, 0, 0.6);
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
  }

  .template-credit a:hover {
    color: rgba(0, 0, 0, 0.8);
    border-bottom-color: rgba(0, 0, 0, 0.3);
  }

  [data-theme="dark"] .template-credit p {
    color: rgba(200, 200, 200, 0.6);
  }

  [data-theme="dark"] .template-credit a {
    color: rgba(200, 200, 200, 0.7);
    border-bottom-color: rgba(255, 255, 255, 0.2);
  }

  [data-theme="dark"] .template-credit a:hover {
    color: rgba(200, 200, 200, 0.9);
    border-bottom-color: rgba(255, 255, 255, 0.35);
  }
</style>
