---
import { CONTENT_TYPES, collectionHref, type ContentType } from "../data/article-editorial";
import type { SiteArticleEntry } from "../utils/site-articles";
interface Props {
  articles: SiteArticleEntry[];
  current?: ContentType;
  compact?: boolean;
}
const { articles, current, compact = false } = Astro.props;
const types = Object.keys(CONTENT_TYPES) as ContentType[];
---
<nav
  class:list={["content-collections", { "content-collections--compact": compact }]}
  aria-label="Browse by content type"
>
  {types.map((type) => (
    <a class="collection-card" href={collectionHref(type)} aria-current={current === type ? "page" : undefined}>
      <span class="collection-card__number">{articles.filter(a => a.contentType === type).length} articles</span>
      <strong>{compact ? CONTENT_TYPES[type].shortLabel : CONTENT_TYPES[type].label} <span aria-hidden="true">↗</span></strong>
      {!compact && <span>{CONTENT_TYPES[type].description}</span>}
    </a>
  ))}
</nav>
